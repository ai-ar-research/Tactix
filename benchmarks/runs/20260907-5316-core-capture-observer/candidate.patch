+  // a per-id table would be linear in the formula on every call.
+  std::sort(originals.begin(), originals.end());
+  for (size_t off = 0; off < arena_.size();) {
+    const uint32_t id = arena_[off];
+    const uint32_t size = arena_[off + 1];
+    const size_t next = off + 2 + size;
+    if (std::binary_search(originals.begin(), originals.end(), id)) {
+      const SubLit *lits = arena_.data() + off + 2;
+      for (auto &cc : out.core_clauses)
+        if (cc.id == id && !cc.learned)
+          cc.lits = export_literals(std::vector<SubLit>(lits, lits + size));
+    }
+    off = next;
+  }
