--- a/src/diagnostics/event_trace.cpp
+++ b/src/diagnostics/event_trace.cpp
@@ -2840,0 +2841,32 @@
+#include "vivify-pose-6016.h"
+
+static void emit_vivify_pose(const Kernel &k, const char *event, uint64_t ordinal,
+                             Ref candidate, uint64_t ticks, uint64_t limit) {
+  if (!vp_enabled(k.stats.conflicts)) return;
+  if (!ordinal && std::strcmp(event, "vivify_candidate_end")) vp_cached = INVALID_REF;
+  int pose[16], values[16];
+  auto matches = [&](Ref ref) {
+    if (ref == INVALID_REF || ref >= k.arena.size()) return false;
+    const Clause *c = clause_at(k.arena, ref);
+    if (c->garbage() || c->size != vp_size) return false;
+    for (unsigned i = 0; i < vp_size; ++i) {
+      pose[i] = kernel_externalize(k, c->lits[i]); values[i] = k.value(c->lits[i]);
+    }
+    return vp_matches(pose) != 0;
+  };
+  if (!matches(vp_cached)) {
+    vp_cached = INVALID_REF;
+    for (Ref ref = 0; ref < k.arena.size();) {
+      if (matches(ref)) { vp_cached = ref; break; }
+      ref += clause_actual_words(clause_at(k.arena, ref));
+    }
+  }
+  const unsigned searched = vp_cached == INVALID_REF ? 0 : clause_at(k.arena, vp_cached)->searched;
+  vp_start(event, k.stats.conflicts, k.vivify_scope, ordinal, ticks, limit, vp_cached, searched, pose, values);
+  const Clause *c = clause_at(k.arena, candidate);
+  std::fprintf(vp_file, "%u\t%u\t%u\t", candidate, c->redundant(), c->garbage());
+  for (unsigned i = 0; i < c->size; ++i)
+    std::fprintf(vp_file, "%s%d", i ? "," : "", kernel_externalize(k, c->lits[i]));
+  std::fputc('\n', vp_file); std::fflush(vp_file);
+}
+
@@ -2843,0 +2876 @@
+  emit_vivify_pose(k, event, ordinal, cref, ticks, limit);
