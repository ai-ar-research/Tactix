+#pragma once
+
+#include <algorithm>
+#include <cassert>
+#include <cstddef>
+#include <vector>
+
+namespace tactix {
+
+// Apply-local Factor occurrence storage. Each literal owns a stable-order
+// slice; appending can relocate that slice or the whole arena. As with kernel
+// watches, raw iterators may not survive a push. Offsets use size_t so this
+// replacement introduces no aggregate 32-bit capacity limit.
+template <class T> class FactorOccurrenceArena {
+  struct Head { size_t offset = 0, size = 0, capacity = 0; };
+  std::vector<Head> heads_;
+  std::vector<T> arena_;
+
+  void push(size_t lit, T value) {
+    Head &h = heads_[lit];
+    if (h.size == h.capacity) {
+      const size_t capacity = h.capacity ? 2 * h.capacity : 1;
+      assert(capacity > h.capacity);
+      if (h.offset + h.capacity == arena_.size()) {
+        arena_.resize(h.offset + capacity);
+      } else {
+        const size_t next = arena_.size();
+        assert(next + capacity >= next);
+        arena_.resize(next + capacity);
+        std::copy_n(arena_.data() + h.offset, h.size,
+                    arena_.data() + next);
+        h.offset = next;
+      }
+      h.capacity = capacity;
+    }
+    arena_[h.offset + h.size++] = value;
+  }
+
+public:
+  class List {
+    FactorOccurrenceArena &owner_;
+    size_t lit_;
+  public:
+    List(FactorOccurrenceArena &owner, size_t lit) : owner_(owner), lit_(lit) {}
+    T *begin() const {
+      return owner_.arena_.empty() ? nullptr :
+          owner_.arena_.data() + owner_.heads_[lit_].offset;
+    }
+    T *end() const { return empty() ? begin() : begin() + size(); }
+    size_t size() const { return owner_.heads_[lit_].size; }
+    bool empty() const { return size() == 0; }
+    T &operator[](size_t i) const { assert(i < size()); return begin()[i]; }
+    void push_back(T value) { owner_.push(lit_, value); }
+    // The matcher compacts survivors in place, then erases only their tail.
+    void erase(T *first, T *last) {
+      assert(last == end());
+      if (empty()) { assert(first == last); return; }
+      assert(first >= begin() && first <= last);
+      owner_.heads_[lit_].size = static_cast<size_t>(first - begin());
+    }
+  };
+  struct ConstList {
+    const T *first;
+    size_t count;
+    const T *begin() const { return first; }
+    const T *end() const { return count ? first + count : first; }
+    size_t size() const { return count; }
+    bool empty() const { return !count; }
+  };
+
+  size_t size() const { return heads_.size(); }
+  void reset(size_t n) { heads_.assign(n, {}); arena_.clear(); }
+  void resize(size_t n) { assert(n >= size()); heads_.resize(n); }
+  List operator[](size_t lit) { assert(lit < size()); return {*this, lit}; }
+  ConstList operator[](size_t lit) const {
+    assert(lit < size());
+    const Head &h = heads_[lit];
+    return {arena_.empty() ? nullptr : arena_.data() + h.offset, h.size};
+  }
+  // Peeling already supplies an upper bound for the final connection pass.
+  // Batch placement avoids per-literal allocations and initial slice moves.
+  template <class Count> void layout(const std::vector<Count> &counts) {
+    assert(counts.size() == size());
+    size_t total = 0;
+    for (size_t lit = 0; lit < size(); ++lit) {
+      const size_t n = counts[lit];
+      assert(total + n >= total);
+      heads_[lit] = {total, 0, n};
+      total += n;
+    }
+    arena_.resize(total);
+  }
+};
+
+} // namespace tactix
