+#undef NDEBUG
+#include "rules/factor/occurrence_arena.hpp"
+#include <algorithm>
+#include <cassert>
+#include <cstdint>
+#include <cstdio>
+#include <vector>
+using namespace tactix;
+
+struct Record {
+  uint32_t ref = UINT32_MAX, cache = UINT32_MAX;
+  bool operator==(const Record &) const = default;
+};
+static_assert(sizeof(Record) == 8);
+
+static void compare(const FactorOccurrenceArena<Record> &arena,
+                    const std::vector<std::vector<Record>> &expected) {
+  assert(arena.size() == expected.size());
+  for (size_t lit = 0; lit < expected.size(); ++lit) {
+    const auto view = arena[lit];
+    assert(view.size() == expected[lit].size());
+    assert(std::equal(view.begin(), view.end(), expected[lit].begin()));
+  }
+}
+
+static void layout_and_growth(unsigned shift, unsigned reserve_extra) {
+  FactorOccurrenceArena<Record> arena;
+  std::vector<std::vector<Record>> expected(17);
+  std::vector<uint32_t> capacities(17);
+  for (size_t lit = 0; lit < 17; ++lit)
+    capacities[lit] = (lit + shift) % 5 + reserve_extra;
+  arena.reset(17);
+  arena.layout(capacities);
+  compare(arena, expected);
+  // Interleaved literal order forces both non-tail moves and tail growth.
+  for (unsigned round = 0; round < 12; ++round) {
+    for (size_t i = 0; i < 17; ++i) {
+      const size_t lit = (i * 7 + shift) % 17;
+      const Record value{round % 3, static_cast<uint32_t>(lit)};
+      arena[lit].push_back(value);
+      expected[lit].push_back(value);
+      compare(arena, expected);
+    }
+  }
+  // Cache mutation must survive later moves of unrelated and own slices.
+  for (size_t lit = 0; lit < 17; ++lit) {
+    arena[lit][2].cache = expected[lit][2].cache = 91;
+    auto list = arena[lit];
+    const auto remove = [](const Record &r) { return r.ref == 1; };
+    list.erase(std::remove_if(list.begin(), list.end(), remove), list.end());
+    auto &ref = expected[lit];
+    ref.erase(std::remove_if(ref.begin(), ref.end(), remove), ref.end());
+    compare(arena, expected);
+  }
+  arena.resize(21);
+  expected.resize(21);
+  for (size_t lit = 0; lit < 21; ++lit) {
+    auto list = arena[lit];
+    list.erase(list.begin(), list.end());
+    expected[lit].clear();
+    list.push_back({static_cast<uint32_t>(lit), 42});
+    expected[lit].push_back({static_cast<uint32_t>(lit), 42});
+    compare(arena, expected);
+  }
+  // Reset and relayout discard every old live entry, including cached IDs.
+  arena.reset(3);
+  arena.layout(std::vector<uint32_t>{0, 0, 0});
+  expected.assign(3, {});
+  auto empty = arena[0];
+  empty.erase(empty.begin(), empty.end());
+  compare(arena, expected);
+  for (size_t lit : {2u, 0u, 1u, 2u}) {
+    arena[lit].push_back({7, 8});
+    expected[lit].push_back({7, 8});
+    compare(arena, expected);
+  }
+}
+
+int main() {
+  for (unsigned shift = 0; shift < 17; ++shift)
+    for (unsigned extra : {0u, 2u}) layout_and_growth(shift, extra);
+  std::puts("factor-occurrence-arena: 34 layouts, growth/cache/stable deletion/empty/reset/fresh literals PASS");
+}
