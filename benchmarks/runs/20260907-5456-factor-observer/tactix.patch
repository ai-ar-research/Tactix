 void EventTrace::emit(const Kernel &k, const char *event, const char *payload,
                       bool snapshot) {
+  // Selected lifecycle observer: reject unrelated snapshots before any
+  // expensive state extraction. Standalone prefix/boundary observers retain
+  // their independent paths; this filter never changes solver state.
+  if (factor_only_ && std::strcmp(event, "trace_begin") &&
+      (std::strncmp(event, "factor_", 7) ||
+       (detail_window_ && (k.stats.conflicts < detail_conflict_from_ ||
+                          k.stats.conflicts > detail_conflict_to_))))
+    return;
   if (std::getenv("SAT_EVENT_TRACE_ALL_ROOTS") &&
       std::strcmp(event, "root_assign") && std::strcmp(event, "analysis_end"))
     return;
--- /dev/null
+++ b/tests/test_factor_observer.cpp
@@ -0,0 +1,42 @@
+#undef NDEBUG
+#include "diagnostics/event_trace.hpp"
+#include "policies/heuristics.hpp"
+#include <cassert>
+#include <cstdio>
+#include <cstdlib>
+#include <fstream>
+#include <string>
+#include <unistd.h>
+using namespace tactix;
+int main() {
+  const std::string path="/tmp/tactix-factor-observer-"+std::to_string(getpid())+".tsv";
+  setenv("TACTIX_EVENT_TRACE",path.c_str(),1);
+  setenv("SAT_EVENT_TRACE_FACTOR_ONLY","1",1);
+  setenv("TACTIX_EVENT_TRACE_CONFLICT_FROM","17",1);
+  setenv("TACTIX_EVENT_TRACE_CONFLICT_TO","17",1);
+  {
+    Kernel k;
+    kernel_reserve_vars(k,3);
+    ScopedHeuristics h(k);
+    EventTrace trace;
+    assert(trace.open_from_env(k));
+    for(unsigned conflict:{16u,17u,18u}) {
+      k.stats.conflicts=conflict;
+      trace.factor_grid(k,internalize(1),2,3,1);
+      trace.factor_grid_member(k,0,internalize(1));
+      trace.macro(k,"probe_begin");
+    }
+  }
+  std::ifstream input(path);
+  std::string line;unsigned grid=0,member=0;
+  while(std::getline(input,line)) {
+    if(line.empty() || line[0]=='#')continue;
+    if(line.find("\ttrace_begin\t")!=std::string::npos)continue;
+    if(line.find("\tfactor_grid\t17\t")!=std::string::npos)grid++;
+    else if(line.find("\tfactor_grid_member\t17\t")!=std::string::npos)member++;
+    else assert(false && "unselected lifecycle/window record");
+  }
+  assert(grid==1 && member==1);
+  assert(std::remove(path.c_str())==0);
+  std::puts("factor observer: selected lifecycle/window PASS");
+}
