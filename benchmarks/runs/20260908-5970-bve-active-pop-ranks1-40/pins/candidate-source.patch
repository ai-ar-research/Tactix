+ApplyResult strengthen_reconnect_and_flush(Kernel &k, uint32_t trail_from) {
+  assert(k.level == 0 && k.dense && k.dense->track_order);
+  assert(!k.large_watches_connected && trail_from <= k.trail.size());
+  if (k.inconsistent)
+    return ApplyResult::Unsat;
