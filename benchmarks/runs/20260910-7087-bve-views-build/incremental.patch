+// Private BVE preparation storage, not a public rule or kernel primitive.
+#pragma once
+#include "kernel/kernel.hpp"
+
+namespace tactix::bve_detail {
+
+// Offsets refer to a stable vector object, never its reallocatable buffer.
+// The same representation serves owned snapshots and read-only arena views.
+template <typename T> struct PoolSlice {
+  const std::vector<T> *pool = nullptr;
+  uint32_t offset = 0;
+  uint32_t length = 0;
+  using const_iterator = typename std::vector<T>::const_iterator;
+  const_iterator begin() const {
+    assert(pool && offset <= pool->size());
+    assert(length <= pool->size() - offset);
+    return pool->cbegin() + offset;
+  }
+  const_iterator end() const { return begin() + length; }
+  size_t size() const { return length; }
+  bool empty() const { return !length; }
+  const T *data() const { return length ? pool->data() + offset : nullptr; }
+  const T &operator[](size_t i) const {
+    assert(i < length);
+    return (*pool)[offset + i];
+  }
+};
+
+template <typename T>
+PoolSlice<T> pool_slice(const std::vector<T> &pool, size_t begin) {
+  assert(begin <= pool.size());
+  assert(begin <= UINT32_MAX && pool.size() - begin <= UINT32_MAX);
+  return {&pool, static_cast<uint32_t>(begin),
+          static_cast<uint32_t>(pool.size() - begin)};
+}
+
+// A BVE attempt does not collect or rewrite antecedent literals until after
+// its last witness consumer. It may grow the arena, mark clauses garbage or
+// assign immediate units. Offsets survive growth; root assignments do not
+// change this gathered image. No iterator may span an arena-mutating call.
+// Root-false clauses instead require a snapshot: definition import still sees
+// the physical literals, while resolution/witnesses see their filtered image.
+// Return false for a satisfied clause, restoring both pools to their entry size.
+inline bool gather_antecedent(const Kernel &k, Ref ref, bool lrat,
+                              std::vector<Lit> &lits,
+                              std::vector<uint64_t> &units,
+                              PoolSlice<Lit> &active,
+                              PoolSlice<uint64_t> &absorbed) {
+  const Clause *c = clause_at(k.arena, ref);
+  const size_t lits_begin = lits.size(), units_begin = units.size();
+  bool snapshot = false;
+  for (const Lit *p = c->begin(); p != c->end(); ++p) {
+    const Lit l = *p;
+    const int8_t value = k.value(l);
+    if (value > 0) {
+      lits.resize(lits_begin);
+      units.resize(units_begin);
+      return false;
+    }
+    if (value < 0) {
+      if (!snapshot) {
+        // Everything before the first false root was unassigned. Copy that
+        // prefix once, and retain the old order of subsequent literals/hints.
+        lits.insert(lits.end(), c->begin(), p);
+        snapshot = true;
+      }
+      if (lrat)
+        units.push_back(k.unit_ids[var_of(l)]);
+    } else if (snapshot) {
+      lits.push_back(l);
+    }
+  }
+  if (snapshot) {
+    active = pool_slice(lits, lits_begin);
+  } else {
+    active = {&k.arena, ref + CLAUSE_HEADER_WORDS, c->size};
+  }
+  absorbed = pool_slice(units, units_begin);
+  return true;
+}
+
+} // namespace tactix::bve_detail
