+
+// The mapped view is an import representation, not a new solving algorithm.
+// Compare it to the explicit mapping path, then independently check SAT models
+// and every UNSAT derivation using this suite's existing exhaustive/LRAT oracles.
+void test_mapped_clause_import() {
+  const std::vector<std::vector<std::vector<SubLit>>> inputs = {
+      {}, {{}}, {{0}, {1}},
+      {{0, 2}, {1, 2}, {0, 3}, {1, 3}},
+      {{0, 0, 2}, {1, 3}, {4}, {6, 7}, {2, 4}},
+      {{0, 2, 4}, {1, 2, 4}, {0, 3, 4}, {1, 3, 4}, {5}},
+      {{0, 2, 4}, {1, 3}, {5, 6}, {7, 0}}};
+  SubSolver copied, viewed;
+  copied.start_kitten_session(true);
+  viewed.start_kitten_session(true);
+  unsigned cases = 0, sats = 0, unsats = 0, budgets = 0, refinements = 0;
+  for (unsigned repeat = 0; repeat < 3; ++repeat)
+    for (bool reverse : {false, true})
+      for (bool flip : {false, true})
+        for (uint64_t budget : {uint64_t{0}, uint64_t{1}, uint64_t{8}})
+          for (const auto &input : inputs) {
+            constexpr SubVar except = 7;
+            std::vector<std::vector<SubLit>> physical;
+            std::vector<uint32_t> mapping(32, 0);
+            uint32_t count = 0;
+            Formula compact;
+            for (const auto &row : input) {
+              std::vector<SubLit> clause{sub_lit(except, false)};
+              for (SubLit lit : row)
+                clause.push_back(sub_lit(3 + 5 * sub_var_of(lit),
+                                         ((lit & 1u) != 0) != flip));
+              // Omit the pivot by variable, including repeated/opposite signs.
+              clause.push_back(sub_lit(except, true));
+              if (reverse) std::reverse(clause.begin(), clause.end());
+              std::vector<SubLit> mapped;
+              for (SubLit lit : clause) {
+                const auto v = sub_var_of(lit);
+                if (v == except) continue;
+                if (!mapping[v]) mapping[v] = ++count;
+                mapped.push_back(sub_lit(mapping[v] - 1, lit & 1u));
+              }
+              physical.push_back(clause);
+              compact.clauses.push_back(mapped);
+            }
+            compact.nvars = count;
+            copied.reset_compact_kitten(count);
+            viewed.reset_compact_kitten(count);
+            for (size_t i = 0; i < physical.size(); ++i) {
+              assert(copied.add_clause(compact.clauses[i]) ==
+                     viewed.add_mapped_clause(physical[i], except, mapping));
+              // Nothing in the engine may retain either caller-owned view.
+              std::fill(physical[i].begin(), physical[i].end(), UINT32_MAX);
+            }
+            std::fill(mapping.begin(), mapping.end(), 0);
+            if (repeat == 1) {
+              copied.randomize_phases();
+              viewed.randomize_phases();
+            }
+            for (unsigned core = 0; core < 2; ++core) {
+              const auto a = copied.solve({}, budget, SubTickMode::Kitten);
+              const auto b = viewed.solve({}, budget, SubTickMode::Kitten);
+              assert(a == b);
+              assert(copied.ticks() == viewed.ticks());
+              assert(copied.kitten_ticks() == viewed.kitten_ticks());
+              assert(copied.kitten_generator() == viewed.kitten_generator());
+              assert(copied.kitten_phase_capacity() == viewed.kitten_phase_capacity());
+              assert(copied.conflicts() == viewed.conflicts());
+              assert(copied.original_clauses() == viewed.original_clauses());
+              if (a == SubResult::Budget) { ++budgets; break; }
+              assert((a == SubResult::Sat) == brute_force(compact, {}));
+              if (a == SubResult::Sat) {
+                ++sats;
+                assert(copied.model() == viewed.model());
+                uint32_t bits = 0;
+                for (SubVar v = 0; v < count; ++v)
+                  if (viewed.model()[v] > 0) bits |= 1u << v;
+                assert(satisfied_by(compact, bits));
+                break;
+              }
+              ++unsats;
+              SubDerivation da, db;
+              assert(copied.derivation(da, true) && viewed.derivation(db, true));
+              assert(da.core == db.core && da.steps.size() == db.steps.size());
+              assert(da.core_clauses.size() == db.core_clauses.size());
+              std::map<uint32_t, std::vector<SubLit>> clauses;
+              for (size_t i = 0; i < compact.clauses.size(); ++i) {
+                auto &clean = clauses[static_cast<uint32_t>(i + 1)];
+                for (auto lit : compact.clauses[i])
+                  if (std::find(clean.begin(), clean.end(), lit) == clean.end())
+                    clean.push_back(lit);
+              }
+              for (size_t i = 0; i < da.steps.size(); ++i) {
+                const auto &x = da.steps[i], &y = db.steps[i];
+                assert(x.id == y.id && x.lits == y.lits && x.chain == y.chain);
+                assert(x.antecedents == y.antecedents);
+                assert(lrat_replay(clauses, y));
+                clauses[y.id] = y.lits;
+              }
+              for (size_t i = 0; i < da.core_clauses.size(); ++i) {
+                const auto &x = da.core_clauses[i], &y = db.core_clauses[i];
+                assert(x.id == y.id && x.learned == y.learned && x.lits == y.lits);
+              }
+              if (core || db.core.empty()) break;
+              copied.shrink_to_clausal_core(da.core);
+              viewed.shrink_to_clausal_core(db.core);
+              copied.shuffle_clauses();
+              viewed.shuffle_clauses();
+              ++refinements;
+            }
+            ++cases;
+          }
+  assert(cases == 252 && sats && unsats && budgets && refinements);
+  printf("  mapped import: %u fixed cases, %u SAT / %u UNSAT / %u budgets, %u refinements\n",
+         cases, sats, unsats, budgets, refinements);
@@ -765,0 +880 @@
+  test_mapped_clause_import();
