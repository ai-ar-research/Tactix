+// Exact watch-head metadata preservation across two-word mutations.
+#undef NDEBUG
+#include <cassert>
+#include "kernel/watch.hpp"
+#include <algorithm>
+#include <cstdio>
+#include <vector>
+
+using namespace tactix;
+
+int main() {
+  unsigned cases = 0;
+  for (unsigned binaries = 0; binaries <= 6; ++binaries)
+    for (unsigned large = 0; large <= 6; ++large)
+      for (unsigned interleave = 0; interleave != 2; ++interleave)
+        for (unsigned drop = 0; drop <= large; ++drop) {
+          WatchLists lists;
+          lists.resize_lits(2);
+          unsigned b = 0, l = 0;
+          while (b < binaries || l < large) {
+            if (b < binaries && (!interleave || l >= large || b < l)) {
+              lists.push_binary(0, 2 + b++);
+            } else {
+              const auto metadata = lists.heads[0].binary_count_and_order;
+              lists.push_large(0, 20 + l, 100 + l);
+              assert(lists.heads[0].binary_count_and_order == metadata);
+              ++l;
+            }
+            // Relocate the next append's slice as well as exercising tail growth.
+            lists.push_large(1, 80, 400);
+          }
+          const WatchHead before = lists.heads[0];
+          const auto holes = lists.holes;
+          std::vector<uint32_t> expected;
+          unsigned removed = 0;
+          for (const WatchEntry entry : lists.entries(0)) {
+            if (!entry.binary() && removed < drop) {
+              ++removed;
+              continue;
+            }
+            expected.push_back(*entry.word);
+            if (!entry.binary()) expected.push_back(entry.ref());
+          }
+          assert(removed == drop);
+          std::copy(expected.begin(), expected.end(), lists.begin(0));
+          lists.truncate_large(0, static_cast<uint32_t>(expected.size()));
+          const WatchHead after = lists.heads[0];
+          assert(after.binary_count_and_order == before.binary_count_and_order);
+          assert(after.binary_count() == binaries);
+          assert(after.binaries_first() == before.binaries_first());
+          assert(after.has_large() == (large != drop));
+          assert(after.offset == before.offset && after.capacity == before.capacity);
+          assert(after.size == binaries + 2 * (large - drop));
+          assert(lists.holes == holes + 2 * drop);
+          assert(std::equal(expected.begin(), expected.end(), lists.begin(0)));
+          ++cases;
+        }
+  assert(cases == 392);
+  puts("watch metadata: 392 exact old/new preservation cases passed");
+}
