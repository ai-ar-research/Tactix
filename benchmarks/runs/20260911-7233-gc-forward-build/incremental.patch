+// Actual collector states; the build gate also runs this against retained7144.
+#undef NDEBUG
+#include "kernel/kernel.hpp"
+#include <cassert>
+#include <cstdio>
+#include <vector>
+using namespace tactix;
+
+static uint64_t digest = 14695981039346656037ull;
+static void word(uint64_t x) {
+  for (unsigned i = 0; i < 8; ++i, x >>= 8) {
+    digest ^= x & 255;
+    digest *= 1099511628211ull;
+  }
+}
+
+static void scenario(unsigned cut, unsigned mask, bool alias, bool dense,
+                     bool preserve) {
+  Kernel k;
+  kernel_reserve_vars(k, 12);
+  const Lit shared = internalize(1);
+  std::vector<Ref> refs;
+  for (unsigned i = 0; i < 6; ++i) {
+    const Lit lits[] = {shared, internalize(2+i), internalize(8),
+                        internalize(9)};
+    refs.push_back(kernel_add_large_clause(k, lits, 3+(i&1), i&1, 6, 100+i));
+    // Interleave binaries and large entries, retaining mirrored identities.
+    kernel_add_binary_clause(k, shared, internalize(2+i), 200+i);
+    clause_at(k.arena, refs.back())->searched = 2+(i&1);
+  }
+  const Ref end = static_cast<Ref>(k.arena.size());
+  const Ref start = cut == 6 ? end : refs[cut];
+  if (alias) {
+    const Lit replacement[] = {shared, internalize(2), internalize(10)};
+    const Ref r = kernel_add_large_clause(k, replacement, 3, false, 0, 300);
+    kernel_inherit_clause_position(k, 300, refs[0]);
+    kernel_swap_large_watch_refs(k, shared, refs[0], r,
+                                internalize(2), internalize(2));
+    kernel_delete_clause(k, clause_at(k.arena, refs[0]));
+  }
+  for (unsigned i = 0; i < 4; ++i)
+    if (mask & (1u << i)) kernel_delete_clause(k, clause_at(k.arena, refs[i]));
+  // Small old search cursors must never be mistaken for live prefix Refs.
+  // Include both live and garbage eager/OTFS register entries.
+  k.eager_recent[0] = refs[5];
+  k.eager_recent[1] = refs[0];
+  k.otfs_retired.push_back(refs[4]);
+  k.otfs_retired.push_back(refs[0]);
+  OccIndex occurrences;
+  if (dense) {
+    kernel_dense_connect(k, occurrences, false);
+    kernel_flush_large_watches(k);
+  }
+  kernel_collect_garbage(k, start, true, preserve);
+  kernel_check_invariants(k);
+  word(cut); word(mask); word(alias); word(dense); word(preserve);
+  word(k.arena.size());
+  for (const auto x : k.arena) word(x);
+  word(k.watches.holes); word(k.watches.arena.size());
+  for (Lit lit = 0; lit < 2*k.nvars; ++lit) {
+    const auto &h = k.watches.heads[lit];
+    word(h.offset); word(h.size); word(h.capacity); word(h.binary_count_and_order);
+    for (unsigned i = 0; i < h.size; ++i) word(k.watches.arena[h.offset+i]);
+    if (dense) {
+      word(occurrences.large[lit].size());
+      for (const Ref ref : occurrences.large[lit]) word(ref);
+    }
+  }
+  for (const Ref ref : k.eager_recent) word(ref);
+  word(k.otfs_retired.size());
+  for (const Ref ref : k.otfs_retired) word(ref);
+  word(k.first_reducible); word(k.arena_generation); word(k.stats.deleted);
+  if (dense) kernel_dense_disconnect(k);
+}
+
+int main() {
+  unsigned count = 0;
+  for (unsigned cut = 0; cut <= 6; ++cut)
+    for (unsigned mask = 0; mask < 16; ++mask)
+      for (bool alias : {false, true})
+        for (bool dense : {false, true})
+          for (bool preserve : {false, true}) {
+            scenario(cut, mask, alias, dense, preserve);
+            ++count;
+          }
+  assert(count == 896);
+  std::printf("gc-forward states=%u digest=%016llx PASS\n", count,
+              static_cast<unsigned long long>(digest));
+}
