@@ -0,0 +1,65 @@
+// Compare fused watch maintenance with the retained two-pass operation.
+#undef NDEBUG
+#include "kernel/watch.hpp"
+#include <cassert>
+#include <cstdio>
+#include <vector>
+using namespace tactix;
+
+static void equal_live(const WatchLists &a, const WatchLists &b) {
+  assert(a.holes == b.holes && a.heads.size() == b.heads.size());
+  assert(a.arena.size() == b.arena.size());
+  for (Lit l = 0; l < a.heads.size(); ++l) {
+    const auto &x = a.heads[l], &y = b.heads[l];
+    assert(x.offset == y.offset && x.size == y.size && x.capacity == y.capacity);
+    assert(x.binary_count_and_order == y.binary_count_and_order);
+    for (uint32_t i = 0; i < x.size; ++i)
+      assert(a.arena[x.offset+i] == b.arena[y.offset+i]);
+  }
+}
+
+int main() {
+  unsigned cases = 0;
+  // Base3 entry streams cover empty, binary-only, large-only and every mixed
+  // order through length7. Repeated references test duplicate retention.
+  for (unsigned n = 0, limit = 1; n <= 7; ++n, limit *= 3) {
+    for (unsigned encoding = 0; encoding < limit; ++encoding) {
+      WatchLists seed;
+      seed.resize_lits(6);
+      seed.push_binary(1,3); // unrelated lists must not move or change
+      unsigned code = encoding;
+      for (unsigned i = 0; i < n; ++i, code /= 3) {
+        const unsigned type = code % 3;
+        if (!type) seed.push_binary(0,2+(i&1));
+        else seed.push_large(0,2+(i&1),type == 1 ? 0 : 8);
+      }
+      seed.push_large(4,5,24);
+      for (unsigned mask = 0; mask < 4; ++mask) {
+        for (unsigned identity = 0; identity < 2; ++identity) {
+          WatchLists actual = seed, expected = seed;
+          const auto map = [=](Ref ref) {
+            assert(ref == 0 || ref == 8);
+            if (!(mask & (ref == 0 ? 1u : 2u))) return INVALID_REF;
+            return identity ? ref : (ref == 0 ? Ref{16} : Ref{0});
+          };
+          // Empty and unaffected lists included, not just the target list.
+          actual.compact_map_large(2,[](Ref) { assert(false); return INVALID_REF; });
+          expected.compact(2,[](WatchEntry) { assert(false); return false; });
+          expected.map_large_refs(2,[](Ref) { assert(false); return INVALID_REF; });
+          actual.compact_map_large(0,map);
+          expected.compact(0,[&](WatchEntry w) { return w.binary() || map(w.ref()) != INVALID_REF; });
+          expected.map_large_refs(0,map);
+          equal_live(actual,expected);
+          // A later append consumes spare words; old dead-tail bytes must not
+          // affect the resulting live representation or hole accounting.
+          actual.push_large(0,5,32); expected.push_large(0,5,32);
+          actual.push_binary(0,4); expected.push_binary(0,4);
+          equal_live(actual,expected);
+          ++cases;
+        }
+      }
+    }
+  }
+  assert(cases == 26240);
+  std::printf("watch compact-map cases=%u exact live words/layout/holes PASS\n",cases);
+}
