+// Exhaustive small sign sets pin completeness, polarity and public read-only
+// extraction. Run this same fixture against the actual previous/new objects.
+#undef NDEBUG
+#include "kernel/kernel.hpp"
+#include "rules/congruence/congruence.hpp"
+#include <algorithm>
+#include <cassert>
+#include <cstdio>
+#include <vector>
+using namespace tactix;
+
+static uint64_t digest = 1469598103934665603ull;
+static void mix(uint64_t value) {
+  for (unsigned byte = 0; byte < 8; byte++) {
+    digest ^= (value >> (8*byte)) & 255;
+    digest *= 1099511628211ull;
+  }
+}
+static void gates_digest(const std::vector<CongGate> &gates) {
+  mix(gates.size());
+  for (const auto &g : gates) {
+    mix(static_cast<unsigned>(g.kind)); mix(g.output); mix(g.base_id());
+    mix(g.inputs.size()); for (Lit lit : g.inputs) mix(lit);
+    mix(g.input_bin_ids().size()); for (auto id : g.input_bin_ids()) mix(id);
+  }
+}
+static void add(Kernel &k, std::vector<Lit> lits, bool reverse) {
+  if (reverse) std::reverse(lits.begin(), lits.end());
+  kernel_add_large_clause(k, lits.data(), lits.size(), false, 0, ++k.next_clause_id);
+}
+static void subset(unsigned mask, unsigned padding, bool reverse, unsigned copies) {
+  Kernel k; kernel_reserve_vars(k, 8);
+  for (unsigned v = 0; v < padding; v++) {
+    k.unit_ids[3+v] = ++k.next_clause_id;
+    kernel_assign_unit(k, make_lit(3+v, true));
+  }
+  for (unsigned visit = 0; visit < 8; visit++) {
+    const unsigned signs = reverse ? 7-visit : visit;
+    if (!(mask & (1u << signs))) continue;
+    std::vector<Lit> row;
+    for (unsigned v = 0; v < 3; v++) row.push_back(make_lit(v, (signs >> v)&1));
+    for (unsigned v = 0; v < padding; v++) row.push_back(make_lit(3+v, false));
+    for (unsigned copy = 0; copy < copies; copy++) add(k, row, reverse);
+  }
+  // Interleaved signed/repeated prefixes and larger records must not shift
+  // the presence-byte ordinal when an earlier XOR candidate is skipped.
+  add(k, {internalize(1),internalize(-1),internalize(2)}, reverse);
+  add(k, {internalize(1),internalize(2),internalize(3),internalize(7)}, reverse);
+  add(k, {internalize(-1),internalize(2),internalize(7),internalize(8)}, reverse);
+  const auto arena = k.arena;
+  const auto watches = k.watches.arena;
+  const auto trail = k.trail;
+  std::vector<CongGate> gates;
+  congruence_extract_gates(k, gates, true);
+  assert(k.arena == arena && k.watches.arena == watches && k.trail == trail);
+  const bool even = (mask & 0x69) == 0x69, odd = (mask & 0x96) == 0x96;
+  unsigned count = 0;
+  for (const auto &g : gates) if (g.kind == GateKind::Xor) {
+    assert(even || odd);
+    assert(g.output == make_lit(count, even));
+    assert(g.inputs.size() == 2);
+    unsigned i = 0;
+    for (unsigned v = 0; v < 3; v++)
+      if (v != count) assert(g.inputs[i++] == make_lit(v, false));
+    // Every model of the original sign set satisfies every emitted gate.
+    for (unsigned assignment = 0; assignment < 8; assignment++) {
+      bool model = true;
+      for (unsigned signs = 0; signs < 8; signs++)
+        if (mask & (1u << signs)) model &= assignment != signs;
+      if (!model) continue;
+      bool rhs = false;
+      for (Lit lit : g.inputs) rhs ^= bool((assignment >> var_of(lit)) & 1);
+      const bool lhs = bool((assignment >> var_of(g.output)) & 1) ^ negated(g.output);
+      assert(lhs == rhs);
+    }
+    count++;
+  }
+  assert(count == (even || odd ? 3u : 0u));
+  mix(mask); mix(padding); mix(reverse); mix(copies);
+  gates_digest(gates); mix(k.stats.congruence_ticks);
+  std::vector<CongGate> repeated;
+  congruence_extract_gates(k, repeated, true);
+  gates_digest(repeated); mix(k.stats.congruence_ticks);
+  assert(k.arena == arena && k.watches.arena == watches && k.trail == trail);
+}
+static void larger(unsigned width, unsigned parity, int omitted, bool reverse) {
+  Kernel k; kernel_reserve_vars(k, width);
+  for (unsigned signs = 0; signs < (1u << width); signs++) {
+    unsigned p = 0; for (unsigned v = 0; v < width; v++) p ^= (signs >> v)&1;
+    if (p != parity || int(signs) == omitted) continue;
+    std::vector<Lit> row;
+    for (unsigned v = 0; v < width; v++) row.push_back(make_lit(v, (signs >> v)&1));
+    add(k, row, reverse);
+  }
+  std::vector<CongGate> gates; congruence_extract_gates(k, gates, true);
+  unsigned xors = 0;
+  for (const auto &g : gates) if (g.kind == GateKind::Xor) {
+    assert(g.output == make_lit(xors, !parity));
+    assert(g.inputs.size() == width-1); xors++;
+  }
+  assert(xors == (omitted < 0 ? width : 0));
+  gates_digest(gates); mix(k.stats.congruence_ticks);
+}
+int main() {
+  unsigned cases = 0;
+  for (unsigned mask = 0; mask < 256; mask++)
+    for (unsigned padding : {0u,1u,2u})
+      for (bool reverse : {false,true})
+        for (unsigned copies : {1u,2u}) {
+          subset(mask,padding,reverse,copies); cases++;
+        }
+  for (unsigned width : {4u,5u})
+    for (unsigned parity : {0u,1u})
+      for (bool reverse : {false,true}) {
+        larger(width,parity,-1,reverse); cases++;
+        for (unsigned signs = 0; signs < (1u << width); signs++) {
+          unsigned p = 0; for (unsigned v = 0; v < width; v++) p ^= (signs >> v)&1;
+          if (p == parity) { larger(width,parity,signs,reverse); cases++; }
+        }
+      }
+  std::printf("PASS %u XOR presence cases digest=%016llx\n",cases,(unsigned long long)digest);
+}
