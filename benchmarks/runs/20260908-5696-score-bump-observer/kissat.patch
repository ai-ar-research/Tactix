--- a/src/eventtrace.c
+++ b/src/eventtrace.c
@@ -3459,6 +3459,50 @@
 
 void kissat_event_trace_literal (kissat *solver, const char *event,
                                  unsigned lit) {
+  if (!strcmp (event, "score_bump")) {
+    static bool initialized;
+    static const char *path, *selected, *from, *to;
+    static FILE *out;
+    static uint64_t sequence;
+    if (!initialized) {
+      initialized = true;
+      path = getenv ("KISSAT_SCORE_BUMP_TRACE");
+      selected = getenv ("SAT_SCORE_BUMP_EXTERNAL");
+      from = getenv ("SAT_SCORE_BUMP_CONFLICT_FROM");
+      to = getenv ("SAT_SCORE_BUMP_CONFLICT_TO");
+    }
+    const int external = abs (external_literal (solver, lit));
+    bool matches = false;
+    if (selected) {
+      const char *cursor = selected;
+      while (*cursor) {
+        char *end;
+        const long value = strtol (cursor, &end, 10);
+        if (end == cursor) break;
+        if (value == external || value == -external) { matches = true; break; }
+        if (*end != ',') break;
+        cursor = end + 1;
+      }
+    }
+    if (path && *path && matches &&
+        (!from || solver->statistics.conflicts >= strtoull (from, 0, 10)) &&
+        (!to || solver->statistics.conflicts <= strtoull (to, 0, 10))) {
+      if (!out) {
+        out = fopen (path, "w");
+        if (!out) { perror (path); exit (2); }
+        setvbuf (out, 0, _IOLBF, 0);
+        fputs ("# kissat-score-bumps\t1\n"
+               "# solver\tseq\tconflicts\tdecisions\texternal\tscore\t"
+               "increment\tstable\tposition\tlevel\n", out);
+      }
+      const unsigned idx = IDX (lit);
+      fprintf (out, "kissat\t%" PRIu64 "\t%" PRIu64 "\t%" PRIu64
+               "\t%d\t%.17g\t%.17g\t%d\t%u\t%u\n", sequence++,
+               solver->statistics.conflicts, solver->statistics.decisions,
+               external, kissat_get_heap_score (SCORES, idx), solver->scinc,
+               (int) solver->stable, kissat_get_heap_pos (SCORES, idx), solver->level);
+    }
+  }
   if (!strcmp (event, "decision"))
     note_decision_prefix (solver, lit);
   kissat_event_trace_detail (solver, event, external_literal (solver, lit));
