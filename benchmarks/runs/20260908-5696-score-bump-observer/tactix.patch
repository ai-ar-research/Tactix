 void event_trace_detail(const Kernel &k, const char *event, int64_t payload) {
+  // Standalone, read-only admission witness for analyzed-variable bumps.
+  // Unlike a full EventTrace this never hashes the heap or scans the formula.
+  if (!std::strcmp(event, "score_bump")) {
+    static const char *path = std::getenv("TACTIX_SCORE_BUMP_TRACE");
+    static const char *selected = std::getenv("SAT_SCORE_BUMP_EXTERNAL");
+    static const char *from = std::getenv("SAT_SCORE_BUMP_CONFLICT_FROM");
+    static const char *to = std::getenv("SAT_SCORE_BUMP_CONFLICT_TO");
+    static FILE *out = nullptr;
+    static uint64_t sequence = 0;
+    if (path && *path && selected && *selected && k.h && payload > 0 &&
+        payload <= INT32_MAX &&
+        (!from || k.stats.conflicts >= std::strtoull(from, nullptr, 10)) &&
+        (!to || k.stats.conflicts <= std::strtoull(to, nullptr, 10)) &&
+        selected_snapshot_external(selected, static_cast<int>(payload))) {
+      const Lit lit = kernel_internalize(k, static_cast<int>(payload));
+      if (lit != INVALID_LIT) {
+        if (!out) {
+          out = std::fopen(path, "w");
+          if (!out) { std::perror(path); std::exit(2); }
+          std::setvbuf(out, nullptr, _IOLBF, 0);
+          std::fputs("# tactix-score-bumps\t1\n"
+                     "# solver\tseq\tconflicts\tdecisions\texternal\tscore\t"
+                     "increment\tstable\tposition\tlevel\n", out);
+        }
+        const Var v = var_of(lit);
+        std::fprintf(out, "tactix\t%llu\t%llu\t%llu\t%d\t%.17g\t%.17g\t%d\t%u\t%u\n",
+            (unsigned long long)sequence++, (unsigned long long)k.stats.conflicts,
+            (unsigned long long)k.stats.decisions, static_cast<int>(payload),
+            k.h->scores.score[v], k.h->scinc, int(k.h->stable),
+            k.h->scores.pos[v], k.level);
+      }
+    }
+  }
   if (active_trace)
     active_trace->detail(k, event, payload);
 }
--- /dev/null
+++ b/tests/test_score_bump_observer.cpp
@@ -0,0 +1,71 @@
+#undef NDEBUG
+#include "diagnostics/event_trace.hpp"
+#include "policies/heuristics.hpp"
+#include <cassert>
+#include <cstdio>
+#include <cstdlib>
+#include <fstream>
+#include <iterator>
+#include <string>
+#include <sys/wait.h>
+#include <unistd.h>
+
+using namespace tactix;
+
+int main() {
+#ifdef TACTIX_ENABLE_EVENT_TRACE
+  for (unsigned mode = 0; mode != 3; ++mode) {
+    const std::string path = "/tmp/tactix-score-observer-" +
+        std::to_string(getpid()) + "-" + std::to_string(mode) + ".tsv";
+    assert(access(path.c_str(), F_OK) != 0);
+    const pid_t child = fork();
+    assert(child >= 0);
+    if (!child) {
+      unsetenv("TACTIX_EVENT_TRACE");
+      if (mode != 1) setenv("TACTIX_SCORE_BUMP_TRACE", path.c_str(), 1);
+      else unsetenv("TACTIX_SCORE_BUMP_TRACE");
+      if (mode != 2) setenv("SAT_SCORE_BUMP_EXTERNAL", "1,-3", 1);
+      else unsetenv("SAT_SCORE_BUMP_EXTERNAL");
+      setenv("SAT_SCORE_BUMP_CONFLICT_FROM", "10", 1);
+      setenv("SAT_SCORE_BUMP_CONFLICT_TO", "11", 1);
+      Kernel k;
+      kernel_reserve_vars(k, 3);
+      ScopedHeuristics h(k);
+      k.h->stable = true;
+      k.h->scinc = 2.0;
+      k.h->scores.score[0] = 3.0;
+      k.h->scores.score[2] = 7.0;
+      k.stats.decisions = 20;
+      for (uint64_t conflict : {9,10,11,12}) {
+        k.stats.conflicts = conflict;
+        for (int external : {1,2,3}) {
+          const double before = k.h->scores.score[external-1];
+          const auto ticks = k.stats.ticks;
+          const auto trail = k.trail.size();
+          event_trace_detail(k, "other", external);
+          event_trace_detail(k, "score_bump", external);
+          assert(k.h->scores.score[external-1] == before);
+          assert(k.h->scinc == 2.0 && k.stats.ticks == ticks && k.trail.size() == trail);
+        }
+        event_trace_detail(k, "score_bump", 0);
+        event_trace_detail(k, "score_bump", -1);
+        event_trace_detail(k, "score_bump", INT64_MAX);
+      }
+      std::exit(0);
+    }
+    int status;
+    assert(waitpid(child, &status, 0) == child && WIFEXITED(status) && WEXITSTATUS(status) == 0);
+    if (mode) { assert(access(path.c_str(), F_OK) != 0); continue; }
+    std::ifstream in(path);
+    const std::string text((std::istreambuf_iterator<char>(in)), {});
+    assert(text == "# tactix-score-bumps\t1\n"
+        "# solver\tseq\tconflicts\tdecisions\texternal\tscore\tincrement\tstable\tposition\tlevel\n"
+        "tactix\t0\t10\t20\t1\t3\t2\t1\t4294967295\t0\n"
+        "tactix\t1\t10\t20\t3\t7\t2\t1\t4294967295\t0\n"
+        "tactix\t2\t11\t20\t1\t3\t2\t1\t4294967295\t0\n"
+        "tactix\t3\t11\t20\t3\t7\t2\t1\t4294967295\t0\n");
+    assert(std::remove(path.c_str()) == 0);
+  }
+#endif
+  std::puts("PASS: standalone score-bump observer selection, boundaries and read-only state");
+}
