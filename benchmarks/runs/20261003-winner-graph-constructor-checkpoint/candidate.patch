diff --git a/src/rules/lucky/graph_labeling_recognition.hpp b/src/rules/lucky/graph_labeling_recognition.hpp
new file mode 100644
index 00000000..601b5b05
--- /dev/null
+++ b/src/rules/lucky/graph_labeling_recognition.hpp
@@ -0,0 +1,167 @@
+#pragma once
+
+#include "kernel/kernel.hpp"
+
+#include <algorithm>
+#include <cstdint>
+#include <utility>
+#include <vector>
+
+namespace tactix::graph_labeling {
+
+// A heuristic projection, never a logical certificate. The indexed rectangle
+// follows the reference encoding: external identity row*N+column selects the
+// vertex at that label. Signs are recovered from the column-cover clauses.
+// Arbitrary renamings without this rectangle are conservatively unsupported.
+struct Shape {
+  uint32_t vertices = 0;
+  uint32_t separation = 0;
+  std::vector<Lit> primary;
+  std::vector<std::pair<uint32_t, uint32_t>> edges;
+  std::vector<std::vector<uint32_t>> adjacency;
+};
+
+// Charge includes clause/watch inspection, mapping/element initialization and
+// graph materialization. maximum_bytes bounds logical workspace payload,
+// excluding allocator overhead and the caller's already-owned Kernel/output.
+// Failure publishes no partial shape and never changes Kernel or proof state.
+template<class Charge>
+bool recognize(const Kernel &k, uint32_t maximum_vertices,
+               uint64_t maximum_bytes, Charge &&charge, Shape &out) {
+  out = {};
+  Shape shape;
+  uint32_t n = 0;
+  const uint64_t external_variables = k.external_to_internal.size();
+  // A cheap first pass selects a possible dimension from an indexed column.
+  // Full coverage and distinct rows are checked before the result is exposed.
+  for (Ref ref = 0; ref < k.arena.size();) {
+    const Clause *clause = clause_at(k.arena, ref);
+    if (!charge(1)) return false;
+    const uint32_t width = clause->size;
+    if (!clause->garbage() && !clause->redundant() && width >= 3 &&
+        width > n && width <= maximum_vertices &&
+        uint64_t(width) * width <= external_variables) {
+      uint32_t column = UINT32_MAX;
+      bool plausible = true;
+      for (Lit lit : *clause) {
+        if (!charge(1)) return false;
+        const Var external = k.internal_to_external[var_of(lit)];
+        if (uint64_t(external) >= uint64_t(width) * width ||
+            (column != UINT32_MAX && external % width != column)) {
+          plausible = false;
+          break;
+        }
+        column = external % width;
+      }
+      if (plausible) n = width;
+    }
+    ref += clause_actual_words(clause);
+  }
+  if (!n) return false;
+  const uint64_t square = uint64_t(n) * n;
+  // Primary literals, edge bitmap, fully reserved edge/adjacency vectors,
+  // row/column marks, and vector descriptors fit this conservative bound.
+  if (square > (UINT64_MAX - uint64_t(n) * 64) / 16 ||
+      square * 16 + uint64_t(n) * 64 > maximum_bytes ||
+      square > SIZE_MAX / sizeof(Lit) || !charge(square + 3 * uint64_t(n)))
+    return false;
+  shape.primary.assign(static_cast<size_t>(square), INVALID_LIT);
+  std::vector<uint8_t> columns(n, 0), rows(n, 0);
+  std::vector<Lit> recovered(n);
+  for (Ref ref = 0; ref < k.arena.size();) {
+    const Clause *clause = clause_at(k.arena, ref);
+    if (!charge(1)) return false;
+    if (!clause->garbage() && !clause->redundant() &&
+        clause->size >= 3 && clause->size <= n) {
+      if (!charge(n)) return false;
+      std::fill(rows.begin(), rows.end(), 0);
+      uint32_t column = UINT32_MAX;
+      bool indexed = true;
+      for (Lit lit : *clause) {
+        if (!charge(1)) return false;
+        const Var external = k.internal_to_external[var_of(lit)];
+        if (external >= square || rows[external / n] ||
+            (column != UINT32_MAX && external % n != column)) {
+          indexed = false;
+          break;
+        }
+        rows[external / n] = 1;
+        recovered[external / n] = lit;
+        column = external % n;
+      }
+      if (indexed) {
+        // Parsing may remove root-false entries before storing a column.
+        // Reconstruct only such entries; an unassigned missing row is not
+        // evidence of a cover. Fixed entries cannot be selected by a validated
+        // completion, regardless of their historical sign convention.
+        for (uint32_t row = 0; row < n; ++row) {
+          if (!charge(1)) return false;
+          if (rows[row]) continue;
+          const Var internal = k.external_to_internal[uint64_t(row) * n + column];
+          if (internal == INVALID_VAR || internal >= k.nvars ||
+              !k.value(make_lit(internal, false))) {
+            indexed = false;
+            break;
+          }
+          recovered[row] = make_lit(internal, k.value(make_lit(internal, false)) > 0);
+        }
+      }
+      if (indexed) {
+        for (Lit lit : recovered) {
+          if (!charge(1)) return false;
+          const Var external = k.internal_to_external[var_of(lit)];
+          Lit &entry = shape.primary[external];
+          if (kernel_var_retired(k, var_of(lit)) ||
+              (entry != INVALID_LIT && entry != lit))
+            return false;
+          entry = lit;
+        }
+        columns[column] = 1;
+      }
+    }
+    ref += clause_actual_words(clause);
+  }
+  for (uint8_t present : columns) {
+    if (!charge(1) || !present) return false;
+  }
+  if (!charge(square)) return false;
+  std::vector<uint8_t> connected(static_cast<size_t>(square), 0);
+  uint32_t separation = n + 1;
+  for (Lit lit = 0; lit < 2 * k.nvars; ++lit) {
+    if (!charge(1)) return false;
+    const Var first = k.internal_to_external[var_of(lit)];
+    if (first >= square || lit != negate(shape.primary[first])) continue;
+    for (WatchEntry watch : k.watches.entries(lit)) {
+      if (!charge(1)) return false;
+      if (!watch.binary() || lit >= watch.other()) continue;
+      const Var second = k.internal_to_external[var_of(watch.other())];
+      if (second >= square ||
+          watch.other() != negate(shape.primary[second]) ||
+          first % n != second % n || first / n == second / n)
+        continue;
+      const uint32_t a = std::min(first / n, second / n);
+      const uint32_t b = std::max(first / n, second / n);
+      connected[uint64_t(a) * n + b] = 1;
+      separation = std::min(separation, first % n + 1);
+    }
+  }
+  if (separation > n || !charge(square + n)) return false;
+  shape.edges.reserve(static_cast<size_t>(square - n) / 2);
+  shape.adjacency.resize(n);
+  for (auto &row : shape.adjacency) row.reserve(n - 1);
+  for (uint32_t a = 0; a < n; ++a) {
+    for (uint32_t b = a + 1; b < n; ++b) {
+      if (!charge(1)) return false;
+      if (!connected[uint64_t(a) * n + b]) continue;
+      shape.edges.emplace_back(a, b);
+      shape.adjacency[a].push_back(b);
+      shape.adjacency[b].push_back(a);
+    }
+  }
+  shape.vertices = n;
+  shape.separation = separation;
+  out = std::move(shape);
+  return true;
+}
+
+} // namespace tactix::graph_labeling
diff --git a/src/rules/lucky/graph_labeling_repair.hpp b/src/rules/lucky/graph_labeling_repair.hpp
new file mode 100644
index 00000000..af140bc8
--- /dev/null
+++ b/src/rules/lucky/graph_labeling_repair.hpp
@@ -0,0 +1,240 @@
+#pragma once
+
+#include "rules/lucky/graph_labeling_search.hpp"
+
+#include <cmath>
+
+namespace tactix::graph_labeling {
+
+using ScoreDelta = std::pair<int64_t, int64_t>;
+
+// Source-backed repair choices from LymphoSAT's antibandwidth constructor.
+// Work/iteration ceilings and random streams are always supplied by the caller.
+struct AnnealChoices {
+  uint32_t bad_endpoint_percent = 80;
+  uint32_t nearby_label_percent = 70;
+  uint32_t refresh_period = 1024;
+  uint32_t cooling_ppm = 999970;
+  uint32_t minimum_temperature_milli = 50;
+};
+struct RepairChoices {
+  uint32_t bad_edge_probes = 80;
+  uint32_t random_labels = 24;
+  uint32_t noise_percent = 6;
+};
+
+inline Score edge_score(uint32_t a, uint32_t b, uint32_t separation) {
+  const uint32_t distance = a > b ? a - b : b - a;
+  if (distance >= separation) return {0, 0};
+  const uint64_t deficit = separation - distance;
+  return {1, deficit * deficit};
+}
+
+// Visit exactly the incident edges affected by the swap. The mutual edge is
+// counted once; there is no temporary formula or assignment mutation to undo.
+template<class Charge>
+bool swap_delta(const Shape &shape, const Candidate &current,
+                uint32_t a, uint32_t b, Charge &charge, ScoreDelta &out) {
+  ScoreDelta delta{0, 0};
+  if (a == b) { out = delta; return true; }
+  const auto proposed = [&](uint32_t v) {
+    return current.labels[v == a ? b : v == b ? a : v];
+  };
+  for (uint32_t v : {a, b}) {
+    for (uint32_t u : shape.adjacency[v]) {
+      if (!charge(1)) return false;
+      if (v == b && u == a) continue;
+      const auto before = edge_score(current.labels[v], current.labels[u], shape.separation);
+      const auto after = edge_score(proposed(v), proposed(u), shape.separation);
+      delta.first += int64_t(after.first) - int64_t(before.first);
+      delta.second += int64_t(after.second) - int64_t(before.second);
+    }
+  }
+  out = delta;
+  return true;
+}
+
+inline Score offset_score(Score score, ScoreDelta delta) {
+  const auto add = [](uint64_t value, int64_t change) {
+    return change < 0 ? value - uint64_t(-change) : value + uint64_t(change);
+  };
+  return {add(score.first, delta.first), add(score.second, delta.second)};
+}
+
+template<class Charge>
+bool install_swap(Candidate &current, Candidate &best,
+                  std::vector<uint32_t> &at, uint32_t a, uint32_t b,
+                  ScoreDelta delta, Charge &charge) {
+  const Score score = offset_score(current.score, delta);
+  const bool improve = score < best.score;
+  if (!charge(1 + (improve ? current.labels.size() : 0))) return false;
+  std::swap(at[current.labels[a]], at[current.labels[b]]);
+  std::swap(current.labels[a], current.labels[b]);
+  current.score = score;
+  if (improve) best = current;
+  return true;
+}
+
+template<class Charge>
+bool violated_edges(const Shape &shape, const Candidate &current, Charge &charge,
+                    std::vector<std::pair<uint32_t, uint32_t>> &bad) {
+  bad.clear();
+  for (const auto &edge : shape.edges) {
+    if (!charge(1)) return false;
+    if (edge_score(current.labels[edge.first], current.labels[edge.second],
+                   shape.separation).first)
+      bad.push_back(edge);
+  }
+  return true;
+}
+
+template<class Charge>
+bool anneal_state(const Shape &shape, uint64_t iterations, uint64_t seed,
+                  const AnnealChoices &choices, Charge &charge,
+                  Candidate &current, std::vector<uint32_t> &at,
+                  Candidate &best, uint64_t &attempts) {
+  if (!choices.refresh_period || choices.bad_endpoint_percent > 100 ||
+      choices.nearby_label_percent > 100 || choices.cooling_ppm > 1000000 ||
+      !choices.minimum_temperature_milli) return false;
+  std::mt19937_64 random(seed);
+  const uint32_t n = shape.vertices;
+  double temperature = std::max(1.0, double(shape.separation) * shape.separation / 3.0);
+  const double minimum = double(choices.minimum_temperature_milli) / 1000.0;
+  std::vector<std::pair<uint32_t, uint32_t>> bad;
+  for (uint64_t i = 0; i < iterations && current.score.first; ++i) {
+    if (!charge(1)) return false;
+    ++attempts;
+    if (!(i % choices.refresh_period) && !violated_edges(shape, current, charge, bad))
+      return false;
+    if (bad.empty()) break;
+    uint32_t a;
+    if (random() % 100 < choices.bad_endpoint_percent) {
+      const auto edge = bad[random() % bad.size()];
+      a = (random() & 1) ? edge.first : edge.second;
+    } else a = random() % n;
+    uint32_t label;
+    if (random() % 100 < choices.nearby_label_percent) {
+      const int64_t offset = int64_t(random() % (2 * uint64_t(shape.separation) + 1)) -
+                             shape.separation;
+      label = static_cast<uint32_t>(std::clamp(int64_t(current.labels[a]) + offset,
+                                             int64_t{0}, int64_t(n - 1)));
+    } else label = random() % n;
+    const uint32_t b = at[label];
+    if (a == b) continue;
+    ScoreDelta delta;
+    if (!swap_delta(shape, current, a, b, charge, delta)) return false;
+    bool accept = delta.second <= 0;
+    if (!accept) {
+      // A reproducible [0,1) draw without implementation-specific distributions.
+      const double chance = double(random() >> 11) * 0x1.0p-53;
+      accept = chance < std::exp(-double(delta.second) / temperature);
+    }
+    if (accept)
+      if (!install_swap(current, best, at, a, b, delta, charge)) return false;
+    temperature = std::max(minimum, temperature * choices.cooling_ppm / 1000000.0);
+  }
+  return true;
+}
+
+template<class Charge>
+bool prepare_repair(const Shape &shape, const Candidate &best, Charge &charge,
+                    Candidate &current, std::vector<uint32_t> &at) {
+  if (!shape.vertices || best.labels.size() != shape.vertices ||
+      !charge(3 * uint64_t(shape.vertices))) return false;
+  at.assign(shape.vertices, UINT32_MAX);
+  for (uint32_t v = 0; v < shape.vertices; ++v) {
+    const uint32_t label = best.labels[v];
+    if (label >= shape.vertices || at[label] != UINT32_MAX) return false;
+    at[label] = v;
+  }
+  current = best;
+  return true;
+}
+
+template<class Charge>
+bool anneal(const Shape &shape, uint64_t iterations, uint64_t seed,
+            const AnnealChoices &choices, Charge &&charge,
+            Candidate &best, uint64_t &attempts) {
+  attempts = 0;
+  if (!iterations || !best.score.first) return true;
+  Candidate current;
+  std::vector<uint32_t> at;
+  return prepare_repair(shape, best, charge, current, at) &&
+         anneal_state(shape, iterations, seed, choices, charge, current, at, best, attempts);
+}
+
+// Min-conflict repair probes both endpoints of shuffled violated edges. Labels
+// are drawn from each neighbor's separation boundary and from uniform samples.
+// A bitmap gives the reference's sorted unique label order without repeatedly
+// allocating/sorting a multiset. On a stall, the independently dosed annealer
+// advances the same private state. The best complete candidate is kept even
+// when noise moves the current state away from it.
+template<class Charge>
+bool repair(const Shape &shape, uint64_t rounds, uint64_t anneal_steps_per_stall,
+            uint64_t seed, uint64_t anneal_seed, const RepairChoices &choices,
+            const AnnealChoices &anneal_choices, Charge &&charge,
+            Candidate &best, uint64_t &completed, uint64_t &anneal_attempts) {
+  completed = anneal_attempts = 0;
+  if (!rounds || !best.score.first) return true;
+  if (!choices.bad_edge_probes || choices.noise_percent > 100) return false;
+  Candidate current;
+  std::vector<uint32_t> at;
+  if (!prepare_repair(shape, best, charge, current, at) || !charge(shape.vertices))
+    return false;
+  const uint32_t n = shape.vertices;
+  std::vector<uint8_t> labels(n, 0);
+  std::vector<std::pair<uint32_t, uint32_t>> bad;
+  std::mt19937_64 random(seed);
+  for (uint64_t round = 0; round < rounds && current.score.first; ++round) {
+    if (!charge(1) || !violated_edges(shape, current, charge, bad)) return false;
+    for (size_t i = bad.size(); i > 1; --i) {
+      if (!charge(1)) return false;
+      std::swap(bad[i - 1], bad[random() % i]);
+    }
+    ScoreDelta selected{0, INT64_MAX};
+    uint32_t chosen_a = UINT32_MAX, chosen_b = UINT32_MAX;
+    const size_t probes = std::min<size_t>(bad.size(), choices.bad_edge_probes);
+    for (size_t bi = 0; bi < probes; ++bi) {
+      for (uint32_t a : {bad[bi].first, bad[bi].second}) {
+        if (!charge(n)) return false;
+        std::fill(labels.begin(), labels.end(), 0);
+        for (uint32_t neighbor : shape.adjacency[a]) {
+          if (!charge(1)) return false;
+          const int64_t label = current.labels[neighbor], width = shape.separation;
+          for (int64_t target : {label - width, label + width,
+                                 label - width + 1, label + width - 1})
+            if (target >= 0 && target < n) labels[static_cast<size_t>(target)] = 1;
+        }
+        for (uint32_t i = 0; i < choices.random_labels; ++i) {
+          if (!charge(1)) return false;
+          labels[random() % n] = 1;
+        }
+        for (uint32_t label = 0; label < n; ++label) {
+          if (!charge(1)) return false;
+          if (!labels[label] || at[label] == a) continue;
+          const uint32_t b = at[label];
+          ScoreDelta delta;
+          if (!swap_delta(shape, current, a, b, charge, delta)) return false;
+          if (delta < selected) {
+            chosen_a = a;
+            chosen_b = b;
+            selected = delta;
+          }
+        }
+      }
+    }
+    const bool move = chosen_a != UINT32_MAX &&
+                     (selected.first < 0 || selected.second < 0 ||
+                      random() % 100 < choices.noise_percent);
+    if (move) {
+      if (!install_swap(current, best, at, chosen_a, chosen_b, selected, charge))
+        return false;
+    } else if (!anneal_state(shape, anneal_steps_per_stall, anneal_seed,
+                              anneal_choices, charge, current, at, best, anneal_attempts))
+      return false;
+    ++completed;
+  }
+  return true;
+}
+
+} // namespace tactix::graph_labeling
diff --git a/src/rules/lucky/graph_labeling_search.hpp b/src/rules/lucky/graph_labeling_search.hpp
new file mode 100644
index 00000000..61df4759
--- /dev/null
+++ b/src/rules/lucky/graph_labeling_search.hpp
@@ -0,0 +1,285 @@
+#pragma once
+
+#include "rules/lucky/graph_labeling_recognition.hpp"
+
+#include <numeric>
+#include <random>
+
+namespace tactix::graph_labeling {
+
+using Score = std::pair<uint64_t, uint64_t>; // violated edges, squared deficits
+struct Candidate {
+  // Zero-based label for each vertex. No Boolean auxiliary values are implied.
+  std::vector<uint32_t> labels;
+  Score score{UINT64_MAX, UINT64_MAX};
+};
+
+// Repair/annealing may move vertex zero after the initial normalization.
+// Reflection preserves every edge distance and thus the cached objective;
+// Boolean/root validity is still checked separately before publishing SAT.
+template<class Charge>
+bool normalize_reflection(Candidate &candidate, Charge &&charge) {
+  const size_t n = candidate.labels.size();
+  if (!n || candidate.labels[0] + 1 <= n / 2) return true;
+  if (!charge(n)) return false;
+  for (uint32_t &label : candidate.labels) label = uint32_t(n - 1 - label);
+  return true;
+}
+
+// Stable metered insertion sorting keeps interruption outside a standard-library
+// comparator. Its degree/index ordering is the reference BFS tie break.
+template<class Less, class Charge>
+bool order_vertices(std::vector<uint32_t> &vertices, Less &&less, Charge &charge) {
+  for (size_t i = 1; i < vertices.size(); ++i) {
+    const uint32_t vertex = vertices[i];
+    size_t j = i;
+    while (j) {
+      if (!charge(1)) return false;
+      if (!less(vertex, vertices[j - 1])) break;
+      vertices[j] = vertices[j - 1];
+      --j;
+    }
+    vertices[j] = vertex;
+  }
+  return true;
+}
+
+template<class Charge>
+bool breadth_first_order(const Shape &shape, bool high_start, Charge &charge,
+                         std::vector<uint32_t> &order) {
+  const uint32_t n = shape.vertices;
+  if (!charge(3 * uint64_t(n))) return false;
+  std::vector<uint32_t> starts(n), pending;
+  std::vector<uint8_t> seen(n, 0);
+  pending.reserve(n);
+  order.clear();
+  order.reserve(n);
+  std::iota(starts.begin(), starts.end(), 0);
+  const auto degree_less = [&](uint32_t a, uint32_t b, bool high) {
+    const size_t da = shape.adjacency[a].size(), db = shape.adjacency[b].size();
+    return da == db ? a < b : high ? da > db : da < db;
+  };
+  if (!order_vertices(starts, [&](uint32_t a, uint32_t b) {
+        return degree_less(a, b, high_start);
+      }, charge)) return false;
+  std::vector<uint32_t> neighbors;
+  for (uint32_t start : starts) {
+    if (!charge(1)) return false;
+    if (seen[start]) continue;
+    pending.clear();
+    pending.push_back(start);
+    seen[start] = 1;
+    for (size_t head = 0; head < pending.size(); ++head) {
+      if (!charge(1)) return false;
+      const uint32_t vertex = pending[head];
+      order.push_back(vertex);
+      neighbors.clear();
+      for (uint32_t other : shape.adjacency[vertex]) {
+        if (!charge(1)) return false;
+        if (!seen[other]) neighbors.push_back(other);
+      }
+      if (!order_vertices(neighbors, [&](uint32_t a, uint32_t b) {
+            return degree_less(a, b, false);
+          }, charge)) return false;
+      for (uint32_t other : neighbors) {
+        if (!charge(1)) return false;
+        seen[other] = 1;
+        pending.push_back(other);
+      }
+    }
+  }
+  return true;
+}
+
+template<class Charge>
+bool score_labels(const Shape &shape, const std::vector<uint32_t> &labels,
+                  Charge &charge, Score &out) {
+  Score score{0, 0};
+  for (const auto [a, b] : shape.edges) {
+    if (!charge(1)) return false;
+    const uint32_t distance = labels[a] > labels[b] ? labels[a] - labels[b]
+                                                         : labels[b] - labels[a];
+    if (distance < shape.separation) {
+      ++score.first;
+      const uint64_t deficit = shape.separation - distance;
+      score.second += deficit * deficit;
+    }
+  }
+  out = score;
+  return true;
+}
+
+// The reference's complete 2*2*3*2 construction family: low/high-degree BFS
+// starts, forward/reverse order, alternating ends/two-at-a-time/straight labels,
+// and reflection. A bounded stop retains only fully scored candidates.
+// Shape must come from recognize (or an equivalently validated internal graph).
+// Caller separately admits workspace: O(vertices+edges), no kernel mutation.
+template<class Charge>
+bool order_seeds(const Shape &shape, Charge &&charge, Candidate &best,
+                 uint32_t &completed) {
+  best = {};
+  completed = 0;
+  const uint32_t n = shape.vertices;
+  if (!n || shape.adjacency.size() != n) return false;
+  for (bool high : {false, true}) {
+    std::vector<uint32_t> order;
+    if (!breadth_first_order(shape, high, charge, order)) return false;
+    for (bool reverse : {false, true}) {
+      for (uint32_t mode = 0; mode < 3; ++mode) {
+        for (bool flip : {false, true}) {
+          if (!charge(n)) return false;
+          std::vector<uint32_t> labels(n);
+          uint32_t low = 0, high_label = n - 1;
+          for (uint32_t i = 0; i < n; ++i) {
+            const uint32_t vertex = order[reverse ? n - 1 - i : i];
+            if (mode == 2) labels[vertex] = flip ? n - 1 - i : i;
+            else {
+              const bool from_low = (((mode == 0 ? i : i / 2) & 1) == 0) != flip;
+              labels[vertex] = from_low ? low++ : high_label--;
+            }
+          }
+          if (labels[0] + 1 > n / 2) {
+            if (!charge(n)) return false;
+            for (auto &label : labels) label = n - 1 - label;
+          }
+          Score score;
+          if (!score_labels(shape, labels, charge, score)) return false;
+          ++completed;
+          if (score < best.score) {
+            best.labels = std::move(labels);
+            best.score = score;
+          }
+        }
+      }
+    }
+  }
+  return true;
+}
+
+struct WindowLimits {
+  uint64_t nodes;
+  uint32_t starts;
+  uint32_t early_choices;
+  uint64_t seed;
+};
+enum class WindowStatus { Found, NoCandidate, Limited };
+
+// Place one vertex at each successive label, excluding neighbors of the last
+// separation-1 vertices. Explicit frames avoid recursion on a caller-sized
+// graph. A frame ranks candidates by remaining degree times the number of
+// recent vertices, then descending total degree, matching the reference key
+// without re-counting the same neighbors for each recent vertex. Random ties
+// are stable in shuffled order. Caps/seed belong to the caller's typed profile.
+// On a bounded stop the prior fully scored construction remains available.
+template<class Charge>
+WindowStatus window_search(const Shape &shape, const WindowLimits &limits,
+                           Charge &&charge, Candidate &best, uint64_t &nodes) {
+  nodes = 0;
+  const uint32_t n = shape.vertices;
+  if (!n || !shape.separation || shape.adjacency.size() != n)
+    return WindowStatus::NoCandidate;
+  if (!limits.nodes || !limits.starts || !limits.early_choices)
+    return WindowStatus::Limited;
+  const uint64_t words = (uint64_t(n) + 63) / 64;
+  if (!charge(uint64_t(n) * words + 3 * uint64_t(n)))
+    return WindowStatus::Limited;
+  std::vector<std::vector<uint64_t>> adjacent(n, std::vector<uint64_t>(words, 0));
+  std::vector<uint32_t> starts(n), order;
+  std::vector<uint8_t> used(n, 0);
+  std::iota(starts.begin(), starts.end(), 0);
+  order.reserve(n);
+  for (uint32_t v = 0; v < n; ++v)
+    for (uint32_t u : shape.adjacency[v]) {
+      if (!charge(1)) return WindowStatus::Limited;
+      adjacent[v][u / 64] |= uint64_t{1} << (u % 64);
+    }
+  if (!order_vertices(starts, [&](uint32_t a, uint32_t b) {
+        const size_t da = shape.adjacency[a].size(), db = shape.adjacency[b].size();
+        return da == db ? a < b : da > db;
+      }, charge)) return WindowStatus::Limited;
+  struct Frame { std::vector<uint32_t> choices; size_t next = 0; };
+  std::vector<Frame> frames;
+  frames.reserve(n);
+  std::mt19937_64 random(limits.seed);
+  std::vector<uint64_t> forbidden(words), remaining_degree(n);
+  for (uint32_t si = 0; si < std::min(n, limits.starts); ++si) {
+    if (!charge(n)) return WindowStatus::Limited;
+    std::fill(used.begin(), used.end(), 0);
+    order.assign(1, starts[si]);
+    used[starts[si]] = 1;
+    frames.clear();
+    bool enter = true;
+    while (!order.empty()) {
+      if (enter) {
+        if (nodes == limits.nodes || !charge(1)) return WindowStatus::Limited;
+        ++nodes;
+        const uint32_t depth = static_cast<uint32_t>(order.size());
+        if (depth == n) {
+          if (!charge(n)) return WindowStatus::Limited;
+          Candidate candidate;
+          candidate.labels.resize(n);
+          for (uint32_t i = 0; i < n; ++i) candidate.labels[order[i]] = i;
+          if (candidate.labels[0] + 1 > n / 2) {
+            if (!charge(n)) return WindowStatus::Limited;
+            for (auto &label : candidate.labels) label = n - 1 - label;
+          }
+          if (!score_labels(shape, candidate.labels, charge, candidate.score))
+            return WindowStatus::Limited;
+          best = std::move(candidate);
+          return WindowStatus::Found;
+        }
+        if (!charge(words)) return WindowStatus::Limited;
+        std::fill(forbidden.begin(), forbidden.end(), 0);
+        const uint32_t first = depth >= shape.separation
+                                   ? depth - shape.separation + 1 : 0;
+        for (uint32_t i = first; i < depth; ++i)
+          for (uint64_t word = 0; word < words; ++word) {
+            if (!charge(1)) return WindowStatus::Limited;
+            forbidden[word] |= adjacent[order[i]][word];
+          }
+        Frame frame;
+        for (uint32_t v = 0; v < n; ++v) {
+          if (!charge(1)) return WindowStatus::Limited;
+          if (used[v] || (forbidden[v / 64] & (uint64_t{1} << (v % 64)))) continue;
+          frame.choices.push_back(v);
+          remaining_degree[v] = 0;
+          for (uint32_t u : shape.adjacency[v]) {
+            if (!charge(1)) return WindowStatus::Limited;
+            remaining_degree[v] += !used[u];
+          }
+        }
+        // Fisher-Yates with an explicit draw per choice keeps replay stable.
+        for (size_t i = frame.choices.size(); i > 1; --i) {
+          if (!charge(1)) return WindowStatus::Limited;
+          std::swap(frame.choices[i - 1], frame.choices[random() % i]);
+        }
+        const uint32_t recent = std::min(depth, shape.separation >= 2
+                                                     ? shape.separation - 2 : 0);
+        if (!order_vertices(frame.choices, [&](uint32_t a, uint32_t b) {
+              const uint64_t ra = remaining_degree[a] * recent;
+              const uint64_t rb = remaining_degree[b] * recent;
+              return ra != rb ? ra < rb
+                             : shape.adjacency[a].size() > shape.adjacency[b].size();
+            }, charge)) return WindowStatus::Limited;
+        if (depth < n / 3 && frame.choices.size() > limits.early_choices)
+          frame.choices.resize(limits.early_choices);
+        frames.push_back(std::move(frame));
+        enter = false;
+      }
+      Frame &frame = frames.back();
+      if (frame.next < frame.choices.size()) {
+        const uint32_t vertex = frame.choices[frame.next++];
+        order.push_back(vertex);
+        used[vertex] = 1;
+        enter = true;
+      } else {
+        frames.pop_back();
+        used[order.back()] = 0;
+        order.pop_back();
+      }
+    }
+  }
+  return WindowStatus::NoCandidate;
+}
+
+} // namespace tactix::graph_labeling
diff --git a/src/strategy/graph_labeling_parameters.hpp b/src/strategy/graph_labeling_parameters.hpp
new file mode 100644
index 00000000..cbea77c9
--- /dev/null
+++ b/src/strategy/graph_labeling_parameters.hpp
@@ -0,0 +1,48 @@
+#pragma once
+
+#include <array>
+#include <cstddef>
+#include <cstdint>
+
+namespace tactix {
+struct Kernel;
+namespace strategy {
+
+enum class GraphLabelingStage : uint8_t {
+  Recognition, Construction, Window, Repair, Anneal, FinalRepair,
+  Completion, Publication, Count
+};
+constexpr size_t GRAPH_LABELING_STAGES = static_cast<size_t>(GraphLabelingStage::Count);
+
+// A single constructor action has separately dosed algorithm stages. These
+// allowances sum to its effort ceiling; zero disables a stage. No wall-clock
+// calibration or solver-specific performance default is invented here. The
+// owning policy must install its reviewed nonzero effort profile explicitly.
+struct GraphLabelingParameters {
+  uint32_t maximum_vertices = UINT32_MAX;
+  uint64_t workspace_bytes = UINT64_MAX;
+  std::array<uint64_t, GRAPH_LABELING_STAGES> work{};
+  // LymphoSAT's bounded window-search profile.
+  uint32_t maximum_dfs_vertices = 140;
+  uint64_t maximum_dfs_nodes = 50000000;
+  uint32_t maximum_dfs_starts = 12;
+  uint32_t early_dfs_choices = 28;
+  uint64_t repair_rounds = UINT64_MAX;
+  uint64_t anneal_iterations = UINT64_MAX;
+  uint64_t stall_anneal_iterations = 0;
+  uint64_t seed = 0;
+
+  constexpr bool valid() const {
+    if (maximum_vertices < 3) return false;
+    uint64_t remaining = UINT64_MAX;
+    for (uint64_t allowance : work) {
+      if (allowance > remaining) return false;
+      remaining -= allowance;
+    }
+    return true;
+  }
+  static GraphLabelingParameters from_kernel(const Kernel &);
+};
+
+} // namespace strategy
+} // namespace tactix
diff --git a/src/strategy/guidance_outcome.hpp b/src/strategy/guidance_outcome.hpp
new file mode 100644
index 00000000..93f9139b
--- /dev/null
+++ b/src/strategy/guidance_outcome.hpp
@@ -0,0 +1,35 @@
+#pragma once
+
+#include "kernel/kernel.hpp"
+#include "strategy/rule_invocation.hpp"
+
+namespace tactix::strategy {
+
+// Shared completion interpretation for native and online constructor/guidance
+// actions. Counter reads are pure: do not poll interruption again while
+// reporting a completed operation, or overwrite a certified terminal result.
+struct GuidanceOutcomeSnapshot {
+  uint64_t stale, walk_interrupted, walk_budget, graph_interrupted, graph_budget;
+  explicit GuidanceOutcomeSnapshot(const Kernel &k)
+      : stale(k.stats.local_search_hints_stale),
+        walk_interrupted(k.stats.walk_seed_interrupted),
+        walk_budget(k.stats.walk_seed_budget_exhausted),
+        graph_interrupted(k.stats.graph_labeling_interrupted),
+        graph_budget(k.stats.graph_labeling_budget) {}
+
+  InvocationStatus refine(const Kernel &k, ApplyResult result,
+                          InvocationStatus ordinary) const {
+    if (result == ApplyResult::Sat || result == ApplyResult::Unsat ||
+        result == ApplyResult::Conflict) return ordinary;
+    if (stale != k.stats.local_search_hints_stale) return InvocationStatus::StaleRequest;
+    if (walk_interrupted != k.stats.walk_seed_interrupted ||
+        graph_interrupted != k.stats.graph_labeling_interrupted)
+      return InvocationStatus::Interrupted;
+    if (walk_budget != k.stats.walk_seed_budget_exhausted ||
+        graph_budget != k.stats.graph_labeling_budget)
+      return InvocationStatus::BudgetExhausted;
+    return ordinary;
+  }
+};
+
+} // namespace tactix::strategy
diff --git a/tests/test_graph_labeling_completion.cpp b/tests/test_graph_labeling_completion.cpp
new file mode 100644
index 00000000..b3d73e82
--- /dev/null
+++ b/tests/test_graph_labeling_completion.cpp
@@ -0,0 +1,71 @@
+#undef NDEBUG
+#include "rules/lucky/graph_labeling_completion.hpp"
+#include "policies/heuristics.hpp"
+
+#include <cassert>
+
+using namespace tactix;
+using namespace tactix::graph_labeling;
+
+static void chain(Kernel &k) {
+  kernel_reserve_vars(k, 6);
+  kernel_add_binary_clause(k, internalize(-1), internalize(3));
+  kernel_add_binary_clause(k, internalize(-3), internalize(4));
+  kernel_add_binary_clause(k, internalize(-4), internalize(5));
+  const Lit large[] = {internalize(2), internalize(-5), internalize(6)};
+  kernel_add_large_clause(k, large, 3, false, 0);
+}
+
+int main() {
+  Kernel k;
+  ScopedHeuristics h(k);
+  chain(k);
+  const std::vector<Lit> trail(k.trail.begin(), k.trail.end());
+  const auto saved = k.h->saved, best = k.h->best, target = k.h->target;
+  const auto arena = k.arena;
+  std::vector<uint8_t> model;
+  const std::vector<int8_t> partial{1, -1, 0, 0, 0, 0};
+  uint64_t total_work = 0;
+  const auto count = [&](uint64_t amount) { total_work += amount; return true; };
+  assert(complete_model(k, partial, 4096, count, model) == CompletionStatus::Model);
+  assert((model == std::vector<uint8_t>{1, 0, 1, 1, 1, 1}));
+  assert(k.trail == trail && k.arena == arena);
+  assert(k.h->saved == saved && k.h->best == best && k.h->target == target);
+  for (uint64_t limit = 0; limit < total_work; ++limit) {
+    uint64_t used = 0;
+    const auto bounded = [&](uint64_t amount) {
+      if (amount > limit - used) return false;
+      used += amount;
+      return true;
+    };
+    assert(complete_model(k, partial, 4096, bounded, model) == CompletionStatus::Limited);
+    assert(model.empty() && used <= limit && k.trail == trail);
+  }
+  const auto always = [](uint64_t) { return true; };
+  assert(complete_model(k, partial, 1, always, model) == CompletionStatus::Limited);
+  assert(model.empty());
+  // A graph-level candidate contradicting any additional live constraint is
+  // rejected without a SAT publication, including retained redundant clauses.
+  const Lit contradiction[] = {internalize(-3), internalize(-4), internalize(-5)};
+  kernel_add_large_clause(k, contradiction, 3, true, 0);
+  assert(complete_model(k, partial, 4096, always, model) == CompletionStatus::NoModel);
+  assert(model.empty() && k.trail == trail);
+  {
+    Kernel root;
+    kernel_reserve_vars(root, 2);
+    kernel_assign_unit(root, internalize(-1));
+    assert(complete_model(root, {1, 0}, 4096, always, model) == CompletionStatus::NoModel);
+    assert(model.empty() && root.trail.size() == 1);
+    assert(complete_model(root, {0, 0}, 4096, always, model) == CompletionStatus::Model);
+    assert((model == std::vector<uint8_t>{0, 0}));
+  }
+  {
+    Kernel retired;
+    kernel_reserve_vars(retired, 2);
+    kernel_add_binary_clause(retired, internalize(1), internalize(2));
+    retired.var_status.assign(2, VarStatus::Active);
+    retired.var_status[0] = VarStatus::Eliminated;
+    assert(complete_model(retired, {1, -1}, 4096, always, model) == CompletionStatus::NoModel);
+    assert(model.empty() && retired.trail.empty());
+  }
+}
diff --git a/tests/test_graph_labeling_model.cpp b/tests/test_graph_labeling_model.cpp
new file mode 100644
index 00000000..4e388041
--- /dev/null
+++ b/tests/test_graph_labeling_model.cpp
@@ -0,0 +1,118 @@
+#undef NDEBUG
+#include "rules/lucky/graph_labeling_model.hpp"
+#include "rules/lucky/model.hpp"
+#include "policies/heuristics.hpp"
+#include "strategy/guidance_outcome.hpp"
+#include "strategy/online_inprocess.hpp"
+
+#include <cassert>
+
+using namespace tactix;
+
+static void permutation(Kernel &k, bool difficult) {
+  constexpr uint32_t n = 4;
+  kernel_reserve_vars(k, n * n);
+  for (uint32_t column = 0; column < n; ++column) {
+    std::vector<Lit> cover;
+    for (uint32_t row = 0; row < n; ++row)
+      cover.push_back(make_lit(row * n + column, false));
+    kernel_add_large_clause(k, cover.data(), cover.size(), false, 0);
+  }
+  for (uint32_t row = 0; row < n; ++row)
+    for (uint32_t a = 0; a < n; ++a)
+      for (uint32_t b = a + 1; b < n; ++b)
+        kernel_add_binary_clause(k, make_lit(row * n + a, true),
+                                    make_lit(row * n + b, true));
+  // Redundant same-column graph exclusions. The first fixture's separation
+  // one is solved by a permutation; the second deliberately induces an overly
+  // strong projected objective, which must remain guidance rather than UNSAT.
+  for (uint32_t a = 0; a < n; ++a)
+    for (uint32_t b = a + 1; b < n; ++b)
+      kernel_add_binary_clause(k, make_lit(a * n + (difficult ? 2 : 0), true),
+                                  make_lit(b * n + (difficult ? 2 : 0), true));
+  k.graph_labeling_parameters.work.fill(100000);
+  k.graph_labeling_parameters.workspace_bytes = 1 << 20;
+  k.graph_labeling_parameters.repair_rounds = 3;
+  k.graph_labeling_parameters.anneal_iterations = 20;
+  k.graph_labeling_parameters.stall_anneal_iterations = 3;
+}
+
+int main() {
+  {
+    Kernel k;
+    ScopedHeuristics h(k);
+    permutation(k, false);
+    const auto original = k.graph_labeling_parameters;
+    strategy::OnlineStrategyProgram program;
+    strategy::OnlineInvocation step;
+    step.id = 1;
+    step.rule = "Lucky";
+    step.granularity = strategy::InvocationGranularity::OneInstance;
+    step.instances = {21};
+    step.parameters = strategy::GraphLabelingParameters{};
+    program.sequence = {step};
+    strategy::OnlineStrategyExecutor executor;
+    assert(executor.configure(program, 1));
+    const strategy::GuidanceOutcomeSnapshot before(k);
+    const auto out = executor.advance(k);
+    assert(out.status == strategy::InvocationStatus::BudgetExhausted);
+    assert(before.refine(k, out.rule_result, strategy::InvocationStatus::NoChange) == out.status);
+    assert(k.graph_labeling_parameters.work == original.work);
+    assert(k.trail.empty() && !k.stats.local_search_hints_offered);
+  }
+  {
+    Kernel k;
+    ScopedHeuristics h(k);
+    permutation(k, false);
+    assert(graph_labeling_model_guard(k));
+    assert(graph_labeling_model_apply(k) == ApplyResult::Sat);
+    assert(k.stats.graph_labeling_sat == 1 && k.stats.graph_labeling_seeds == 24);
+    std::vector<uint8_t> model(k.nvars);
+    for (Var v = 0; v < k.nvars; ++v) model[v] = k.value(make_lit(v, false)) > 0;
+    assert(lucky_model_valid(k, model));
+    assert(!graph_labeling_model_guard(k));
+  }
+  {
+    Kernel k;
+    ScopedHeuristics h(k);
+    permutation(k, true);
+    const auto saved = k.h->saved, target = k.h->target, best = k.h->best;
+    assert(graph_labeling_model_apply(k) == ApplyResult::Ok);
+    assert(!k.inconsistent && k.trail.empty());
+    assert(k.stats.graph_labeling_sat == 0 && k.stats.graph_labeling_nodes > 0);
+    assert(k.h->saved == saved && k.h->target == target && k.h->best == best);
+    const auto &hint = k.local_search_hints[size_t(strategy::LocalSearchKind::GraphLabeling)];
+    assert(hint.available() && hint.objective > 0 && hint.objective_exact);
+    assert(hint.effort.amount == k.stats.graph_labeling_work);
+    // Repeated bounded calls publish a fresh exact identity, without sharing
+    // old scores as a logical premise or mutating any trail/proof state.
+    const uint64_t identity = hint.id;
+    assert(graph_labeling_model_apply(k) == ApplyResult::Ok);
+    assert(hint.id != identity && k.trail.empty());
+  }
+  {
+    Kernel k;
+    ScopedHeuristics h(k);
+    permutation(k, false);
+    k.graph_labeling_parameters.work.fill(0);
+    assert(graph_labeling_model_apply(k) == ApplyResult::NoOp);
+    assert(!k.stats.graph_labeling_work && k.stats.graph_labeling_budget == 1);
+    assert(k.trail.empty() && !k.stats.local_search_hints_offered);
+    k.graph_labeling_parameters.work.fill(100000);
+    volatile sig_atomic_t stop = 1;
+    k.stop = &stop;
+    assert(graph_labeling_model_apply(k) == ApplyResult::NoOp);
+    assert(!k.stats.graph_labeling_work && k.stats.graph_labeling_interrupted == 1);
+  }
+  {
+    Kernel k;
+    ScopedHeuristics h(k);
+    permutation(k, false);
+    // An inherited whole-action ceiling also constrains the sum of stages;
+    // publication reservation cannot permit spending beyond that ceiling.
+    k.work_budget = 1;
+    k.work_budget_bounded = true;
+    assert(graph_labeling_model_apply(k) == ApplyResult::NoOp);
+    assert(k.stats.graph_labeling_work <= 1 && k.trail.empty());
+  }
+}
diff --git a/tests/test_graph_labeling_recognition.cpp b/tests/test_graph_labeling_recognition.cpp
new file mode 100644
index 00000000..f6242b94
--- /dev/null
+++ b/tests/test_graph_labeling_recognition.cpp
@@ -0,0 +1,106 @@
+#undef NDEBUG
+#include "rules/lucky/graph_labeling_recognition.hpp"
+#include "policies/heuristics.hpp"
+
+#include <cassert>
+#include <vector>
+
+using namespace tactix;
+
+// Indexed column covers with a sign-renamed Boolean encoding. The graph
+// exclusions begin in column two (one-based separation three), as in the
+// reference's interval encoding. This is only a recognition fixture, not a
+// full Boolean encoding of graph labeling.
+static void rectangle(Kernel &k, bool signed_encoding, bool malformed = false,
+                      bool shortened = false) {
+  constexpr uint32_t n = 4;
+  kernel_reserve_vars(k, n * n + 2);
+  const auto primary = [&](Var v) {
+    return make_lit(v, signed_encoding && (v % 3 == 0));
+  };
+  if (shortened) kernel_assign_unit(k, negate(primary(3)));
+  for (uint32_t column = 0; column < n; ++column) {
+    std::vector<Lit> cover;
+    for (uint32_t row = 0; row < n; ++row)
+      if (k.value(primary(row * n + column)) >= 0)
+        cover.push_back(primary(row * n + column));
+    if (malformed && column == 1) cover[0] = primary(2);
+    std::reverse(cover.begin(), cover.end());
+    kernel_add_large_clause(k, cover.data(), cover.size(), false, 0);
+  }
+  for (uint32_t column = 2; column < n; ++column) {
+    kernel_add_binary_clause(k, negate(primary(column)),
+                             negate(primary(n + column)));
+    kernel_add_binary_clause(k, negate(primary(n + column)),
+                             negate(primary(2 * n + column)));
+  }
+}
+
+int main() {
+  for (bool signs : {false, true}) {
+    Kernel k;
+    rectangle(k, signs);
+    const auto trail = k.trail;
+    uint64_t work = 0;
+    graph_labeling::Shape shape;
+    const auto count = [&](uint64_t amount) { work += amount; return true; };
+    assert(graph_labeling::recognize(k, 4, 1024, count, shape));
+    assert(shape.vertices == 4 && shape.separation == 3);
+    assert((shape.edges == std::vector<std::pair<uint32_t, uint32_t>>{
+                               {0, 1}, {1, 2}}));
+    assert((shape.adjacency[1] == std::vector<uint32_t>{0, 2}));
+    for (Var v = 0; v < 16; ++v)
+      assert(shape.primary[v] == make_lit(v, signs && v % 3 == 0));
+    const uint64_t complete_work = work;
+    for (uint64_t limit = 0; limit < complete_work; ++limit) {
+      uint64_t used = 0;
+      const auto bounded = [&](uint64_t amount) {
+        if (amount > limit - used) return false;
+        used += amount;
+        return true;
+      };
+      assert(!graph_labeling::recognize(k, 4, 1024, bounded, shape));
+      assert(!shape.vertices && shape.primary.empty() && shape.edges.empty());
+      assert(used <= limit && k.trail == trail);
+    }
+    assert(!graph_labeling::recognize(k, 3, 1024, count, shape));
+    assert(!graph_labeling::recognize(k, 4, 1, count, shape));
+    assert(k.trail == trail);
+  }
+  {
+    for (bool signs : {false, true}) {
+      Kernel k;
+      rectangle(k, signs, false, true);
+      graph_labeling::Shape shape;
+      assert(graph_labeling::recognize(k, 4, 1024,
+                                       [](uint64_t) { return true; }, shape));
+      assert(shape.vertices == 4 && shape.primary[3] == make_lit(3, signs));
+      assert(k.value(shape.primary[3]) < 0 && k.trail.size() == 1);
+    }
+  }
+  {
+    Kernel k;
+    rectangle(k, false, true);
+    graph_labeling::Shape shape;
+    assert(!graph_labeling::recognize(k, 4, 1024,
+                                      [](uint64_t) { return true; }, shape));
+  }
+  {
+    Kernel k;
+    ScopedHeuristics h(k);
+    rectangle(k, true);
+    k.var_status.assign(k.nvars, VarStatus::Active);
+    k.var_status[16] = VarStatus::Eliminated;
+    heuristics_deactivate_var(k, 16);
+    --k.unassigned_active;
+    assert(kernel_compact_variables(k));
+    graph_labeling::Shape shape;
+    const auto charge = [](uint64_t) { return true; };
+    assert(graph_labeling::recognize(k, 4, 1024, charge, shape));
+    k.var_status.resize(k.nvars, VarStatus::Active);
+    const Var internal = k.external_to_internal[2];
+    assert(internal < k.nvars);
+    k.var_status[internal] = VarStatus::Eliminated;
+    assert(!graph_labeling::recognize(k, 4, 1024, charge, shape));
+  }
+}
diff --git a/tests/test_graph_labeling_repair.cpp b/tests/test_graph_labeling_repair.cpp
new file mode 100644
index 00000000..979bfd09
--- /dev/null
+++ b/tests/test_graph_labeling_repair.cpp
@@ -0,0 +1,105 @@
+#undef NDEBUG
+#include "rules/lucky/graph_labeling_repair.hpp"
+
+#include <cassert>
+
+using namespace tactix::graph_labeling;
+
+static Shape graph(uint32_t mask) {
+  Shape s;
+  s.vertices = 4;
+  s.separation = 2;
+  s.adjacency.resize(4);
+  uint32_t bit = 0;
+  for (uint32_t a = 0; a < 4; ++a)
+    for (uint32_t b = a + 1; b < 4; ++b, ++bit)
+      if (mask & (1u << bit)) {
+        s.edges.emplace_back(a, b);
+        s.adjacency[a].push_back(b);
+        s.adjacency[b].push_back(a);
+      }
+  return s;
+}
+
+static Score oracle(const Shape &s, const Candidate &c) {
+  auto sorted = c.labels;
+  std::sort(sorted.begin(), sorted.end());
+  assert((sorted == std::vector<uint32_t>{0, 1, 2, 3}));
+  Score result{0, 0};
+  for (uint32_t a = 0; a < s.vertices; ++a)
+    for (uint32_t b : s.adjacency[a]) {
+      if (b <= a) continue;
+      const int64_t distance = std::abs(int64_t(c.labels[a]) - c.labels[b]);
+      if (distance >= s.separation) continue;
+      ++result.first;
+      const uint64_t deficit = s.separation - distance;
+      result.second += deficit * deficit;
+    }
+  return result;
+}
+
+int main() {
+  auto always = [](uint64_t) { return true; };
+  for (uint32_t mask = 0; mask < 64; ++mask) {
+    Shape s = graph(mask);
+    Candidate c;
+    c.labels = {0, 1, 2, 3};
+    do {
+      c.score = oracle(s, c);
+      for (uint32_t a = 0; a < 4; ++a)
+        for (uint32_t b = a; b < 4; ++b) {
+          ScoreDelta delta;
+          assert(swap_delta(s, c, a, b, always, delta));
+          Candidate swapped = c;
+          std::swap(swapped.labels[a], swapped.labels[b]);
+          assert(offset_score(c.score, delta) == oracle(s, swapped));
+          auto best = c, current = c;
+          std::vector<uint32_t> at(4);
+          for (uint32_t v = 0; v < 4; ++v) at[c.labels[v]] = v;
+          assert(install_swap(current, best, at, a, b, delta, always));
+          assert(current.labels == swapped.labels && current.score == oracle(s, current));
+          assert(best.score <= c.score && best.score == oracle(s, best));
+          for (uint32_t v = 0; v < 4; ++v) assert(at[current.labels[v]] == v);
+        }
+    } while (std::next_permutation(c.labels.begin(), c.labels.end()));
+    c.score = oracle(s, c);
+    Candidate repaired = c, annealed = c;
+    uint64_t rounds = 0, attempts = 0;
+    assert(repair(s, 3, 20, 123, 456, {}, {}, always, repaired, rounds, attempts));
+    assert(repaired.score <= c.score && repaired.score == oracle(s, repaired));
+    assert(rounds <= 3 && attempts <= 60);
+    assert(anneal(s, 50, 456, {}, always, annealed, attempts));
+    assert(annealed.score <= c.score && annealed.score == oracle(s, annealed));
+    assert(attempts <= 50);
+    Candidate repeated = c;
+    assert(repair(s, 3, 20, 123, 456, {}, {}, always, repeated, rounds, attempts));
+    assert(repeated.labels == repaired.labels && repeated.score == repaired.score);
+  }
+  // Every work cutoff of an impossible clique retains a valid, correctly
+  // scored best candidate, including cutoffs inside delta evaluation/export.
+  Shape s = graph(63);
+  Candidate initial;
+  initial.labels = {0, 1, 2, 3};
+  initial.score = oracle(s, initial);
+  for (bool use_anneal : {false, true}) {
+    uint64_t work = 0, rounds = 0, attempts = 0;
+    const auto count = [&](uint64_t amount) { work += amount; return true; };
+    Candidate complete = initial;
+    if (use_anneal) assert(anneal(s, 5, 456, {}, count, complete, attempts));
+    else assert(repair(s, 1, 3, 123, 456, {}, {}, count, complete, rounds, attempts));
+    for (uint64_t limit = 0; limit < work; ++limit) {
+      uint64_t used = 0;
+      const auto bounded = [&](uint64_t amount) {
+        if (amount > limit - used) return false;
+        used += amount;
+        return true;
+      };
+      Candidate partial = initial;
+      const bool finished = use_anneal
+          ? anneal(s, 5, 456, {}, bounded, partial, attempts)
+          : repair(s, 1, 3, 123, 456, {}, {}, bounded, partial, rounds, attempts);
+      assert(!finished && used <= limit);
+      assert(partial.score <= initial.score && partial.score == oracle(s, partial));
+    }
+  }
+}
diff --git a/tests/test_graph_labeling_search.cpp b/tests/test_graph_labeling_search.cpp
new file mode 100644
index 00000000..f636f258
--- /dev/null
+++ b/tests/test_graph_labeling_search.cpp
@@ -0,0 +1,136 @@
+#undef NDEBUG
+#include "rules/lucky/graph_labeling_search.hpp"
+
+#include <cassert>
+#include <numeric>
+
+using namespace tactix::graph_labeling;
+
+static Score independent_score(const Shape &shape, const Candidate &candidate) {
+  auto sorted = candidate.labels;
+  std::sort(sorted.begin(), sorted.end());
+  for (uint32_t i = 0; i < shape.vertices; ++i) assert(sorted[i] == i);
+  uint64_t bad = 0, penalty = 0;
+  for (uint32_t v = 0; v < shape.vertices; ++v)
+    for (uint32_t u : shape.adjacency[v]) {
+      if (u <= v) continue;
+      const int64_t distance = std::abs(int64_t(candidate.labels[v]) -
+                                       int64_t(candidate.labels[u]));
+      if (distance >= shape.separation) continue;
+      ++bad;
+      const uint64_t deficit = shape.separation - distance;
+      penalty += deficit * deficit;
+    }
+  return {bad, penalty};
+}
+
+int main() {
+  {
+    // Final repair can undo the seed's reflection convention. Recover it
+    // without changing any pairwise distance or partially mutating on a cut.
+    Candidate original;
+    original.labels = {3, 0, 2, 1};
+    original.score = {7, 19};
+    for (uint64_t limit = 0; limit <= 4; ++limit) {
+      Candidate candidate = original;
+      uint64_t used = 0;
+      const auto charge = [&](uint64_t amount) {
+        if (amount > limit - used) return false;
+        used += amount;
+        return true;
+      };
+      assert(normalize_reflection(candidate, charge) == (limit == 4));
+      assert(candidate.score == original.score);
+      if (limit < 4) {
+        assert(candidate.labels == original.labels && used == 0);
+        continue;
+      }
+      assert((candidate.labels == std::vector<uint32_t>{0, 3, 1, 2}));
+      for (size_t a = 0; a < 4; ++a)
+        for (size_t b = 0; b < 4; ++b)
+          assert(std::abs(int(candidate.labels[a]) - int(candidate.labels[b])) ==
+                 std::abs(int(original.labels[a]) - int(original.labels[b])));
+      assert(normalize_reflection(candidate, charge));
+      assert(used == 4); // Already normalized: no additional work or mutation.
+    }
+  }
+  // Exhaust every simple four-vertex graph, including disconnected graphs and
+  // an impossible separation. Check complete permutations and objective values
+  // independently of the constructor's edge scorer, plus deterministic replay.
+  for (uint32_t mask = 0; mask < 64; ++mask) {
+    Shape shape;
+    shape.vertices = 4;
+    shape.separation = 3;
+    shape.adjacency.resize(4);
+    uint32_t bit = 0;
+    for (uint32_t a = 0; a < 4; ++a)
+      for (uint32_t b = a + 1; b < 4; ++b, ++bit)
+        if (mask & (1u << bit)) {
+          shape.edges.emplace_back(a, b);
+          shape.adjacency[a].push_back(b);
+          shape.adjacency[b].push_back(a);
+        }
+    Candidate candidate;
+    uint64_t work = 0;
+    const auto charge = [&](uint64_t amount) { work += amount; return true; };
+    uint32_t completed = 0;
+    assert(order_seeds(shape, charge, candidate, completed));
+    assert(completed == 24 && candidate.score == independent_score(shape, candidate));
+    Candidate replay;
+    assert(order_seeds(shape, charge, replay, completed));
+    assert(replay.labels == candidate.labels && replay.score == candidate.score);
+    // With all starts/choices allowed this finite search must agree with a
+    // brute-force permutation oracle, even when the seed family misses a model.
+    Candidate brute;
+    brute.labels = {0, 1, 2, 3};
+    bool exists = false;
+    do {
+      exists |= independent_score(shape, brute).first == 0;
+    } while (std::next_permutation(brute.labels.begin(), brute.labels.end()));
+    Candidate searched = candidate;
+    uint64_t nodes = 0;
+    const WindowLimits limits{1000, 4, 4, 123};
+    const auto unbounded = [](uint64_t) { return true; };
+    const auto status = window_search(shape, limits, unbounded, searched, nodes);
+    assert((status == WindowStatus::Found) == exists);
+    assert(status != WindowStatus::Limited && nodes <= limits.nodes);
+    if (exists) {
+      assert(searched.score.first == 0);
+      assert(searched.score == independent_score(shape, searched));
+    } else assert(searched.labels == candidate.labels);
+    if (!mask) {
+      uint64_t dfs_work = 0;
+      const auto dfs_count = [&](uint64_t amount) { dfs_work += amount; return true; };
+      assert(window_search(shape, limits, dfs_count, searched, nodes) == WindowStatus::Found);
+      for (uint64_t limit = 0; limit < dfs_work; ++limit) {
+        uint64_t used = 0;
+        const auto bounded = [&](uint64_t amount) {
+          if (amount > limit - used) return false;
+          used += amount;
+          return true;
+        };
+        searched = candidate;
+        assert(window_search(shape, limits, bounded, searched, nodes) == WindowStatus::Limited);
+        assert(searched.labels == candidate.labels && searched.score == candidate.score);
+      }
+    }
+    if (mask == 0) assert(candidate.score.first == 0);
+    if (mask != 63) continue;
+    // Every possible early stop retains an evaluated permutation, never an
+    // interrupted sort or a half-built assignment.
+    const uint64_t full_work = work / 2;
+    for (uint64_t limit = 0; limit < full_work; ++limit) {
+      uint64_t used = 0;
+      const auto bounded = [&](uint64_t amount) {
+        if (amount > limit - used) return false;
+        used += amount;
+        return true;
+      };
+      Candidate partial;
+      assert(!order_seeds(shape, bounded, partial, completed));
+      assert(used <= limit && completed < 24);
+      if (completed) assert(partial.score == independent_score(shape, partial));
+      else assert(partial.labels.empty());
+    }
+  }
+}
