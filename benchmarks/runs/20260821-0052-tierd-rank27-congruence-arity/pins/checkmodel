#!/usr/bin/env python3
"""checkmodel — independent SAT model checker (plan §8.2, oracle 1).

Usage: checkmodel formula.cnf solver_output.txt

Verifies that the assignment in the solver output's `v` lines satisfies
every clause of the ORIGINAL input formula. A variable not mentioned in the
model satisfies neither polarity.

Exit 0: model satisfies the formula.   Exit 1: it does not (or no v lines).
"""

import os
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
from modelcheck import check_files  # noqa: E402


def main() -> int:
    if len(sys.argv) != 3:
        print("usage: checkmodel formula.cnf solver_output.txt",
              file=sys.stderr)
        return 2
    ok, msg = check_files(sys.argv[1], sys.argv[2])
    print(f"checkmodel: {'OK' if ok else 'FAILED'} — {msg}")
    return 0 if ok else 1


if __name__ == "__main__":
    sys.exit(main())
