 #include <stdio.h>
 #include <stdlib.h>
 #include <string.h>
+
+void kissat_event_trace_subsume_material (kissat *solver, unsigned lit,
+                                          const char *source) {
+  static bool configured;
+  static FILE *out;
+  static uint64_t from, to = UINT64_MAX, conflict_to = UINT64_MAX;
+  if (!configured) {
+    configured = true;
+    const char *path = getenv ("KISSAT_SUBSUME_MATERIAL_TRACE");
+    if (path) {
+      out = fopen (path, "wx");
+      if (!out) {
+        perror ("KISSAT_SUBSUME_MATERIAL_TRACE");
+        exit (2);
+      }
+      setvbuf (out, 0, _IOLBF, 0);
+      const char *s;
+      if ((s = getenv ("SAT_SUBSUME_MATERIAL_FROM"))) from = strtoull (s, 0, 10);
+      if ((s = getenv ("SAT_SUBSUME_MATERIAL_TO"))) to = strtoull (s, 0, 10);
+      if ((s = getenv ("SAT_SUBSUME_MATERIAL_CONFLICT_TO"))) conflict_to = strtoull (s, 0, 10);
+    }
+  }
+  const uint64_t count = solver->statistics.variables_subsume;
+  if (!out || count < from || count > to ||
+      solver->statistics.conflicts > conflict_to)
+    return;
+  const flags *f = solver->flags + IDX (lit);
+  fprintf (out, "kissat\tconflicts=%llu\tdecisions=%llu\tcount=%llu\tsaved=%llu\texternal=%d\tsource=%s\tbefore=0\tafter=%u\tfixed=%u\tactive=%u\tprobing=%u\n",
+           (unsigned long long) solver->statistics.conflicts,
+           (unsigned long long) solver->statistics.decisions,
+           (unsigned long long) count,
+           (unsigned long long) solver->limits.eliminate.variables.subsume,
+           kissat_export_literal (solver, lit), source, f->subsume,
+           f->fixed, f->active, solver->probing);
+}
 
