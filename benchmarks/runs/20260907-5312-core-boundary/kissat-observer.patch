 typedef struct sweeper sweeper;
 
+static bool core_boundary_selected (sweeper *sweeper) {
+  kissat *solver = sweeper->solver;
+  return getenv ("SAT_CORE_BOUNDARY") && solver->statistics.conflicts == 26913 &&
+    kissat_export_literal (solver, LIT (sweeper->trace_seed)) == 563;
+}
+
+static void core_boundary_clause (sweeper *sweeper, const char *kind,
+                                 bool learned, size_t size, const unsigned *lits) {
+  if (!core_boundary_selected (sweeper)) return;
+  kissat *solver = sweeper->solver;
+  fprintf (stderr, "OBS_%s query=%u learned=%u lits=", kind,
+           sweeper->trace_query_ordinal - 1, learned);
+  for (size_t i = 0; i < size; ++i)
+    fprintf (stderr, "%d:%d,", kissat_export_literal (solver, lits[i]),
+             (int) solver->values[lits[i]]);
+  fputc ('\n', stderr);
+}
