+// Fixed actual-rule observer control: disabled, selected and wrong-conflict.
+#undef NDEBUG
+#include "kernel/kernel.hpp"
+#include "rules/congruence/congruence.hpp"
+#include <cassert>
+#include <cstdio>
+#include <cstdlib>
+#include <fstream>
+#include <iterator>
+#include <sstream>
+#include <string>
+#include <sys/wait.h>
+#include <unistd.h>
+using namespace tactix;
+
+static std::string read(const std::string &path) {
+  std::ifstream in(path, std::ios::binary);
+  return std::string(std::istreambuf_iterator<char>(in), {});
+}
+
+static void run_case(const std::string &base, int selection) {
+  unsetenv("TACTIX_CONGRUENCE_BINARY_TRACE_STOP");
+  unsetenv("TACTIX_CONGRUENCE_CANDIDATE_TRACE");
+  if (selection < 0) {
+    unsetenv("TACTIX_CONGRUENCE_BINARY_TRACE");
+    unsetenv("TACTIX_CONGRUENCE_BINARY_TRACE_CONFLICT");
+  } else {
+    setenv("TACTIX_CONGRUENCE_BINARY_TRACE", (base + ".trace").c_str(), 1);
+    setenv("TACTIX_CONGRUENCE_BINARY_TRACE_CONFLICT", selection ? "8" : "7", 1);
+  }
+  Kernel k;
+  kernel_reserve_vars(k, 3);
+  k.stats.conflicts = 7;
+  const Lit ternary[] = {internalize(1), internalize(2), internalize(3)};
+  kernel_add_large_clause(k, ternary, 3, false, 0, ++k.next_clause_id);
+  kernel_add_binary_clause(k, internalize(-1), internalize(2), ++k.next_clause_id);
+  Proof proof;
+  assert(proof.open((base + ".proof").c_str(), ProofFormat::DratAscii));
+  proof.bind_variable_map(&k.internal_to_external);
+  k.proof = &proof;
+  const auto result = congruence_apply(k);
+  assert(result != ApplyResult::Unsat);
+  assert(kernel_binary_live(k, internalize(2), internalize(3)));
+  proof.flush();
+  k.proof = nullptr;
+  std::ofstream out(base + ".state");
+  assert(out);
+  out << static_cast<int>(result) << ' ' << k.next_clause_id << ' '
+      << k.stats.conflicts << ' ' << k.stats.congruence_ticks << ' '
+      << k.stats.propagations << ' ' << k.inconsistent << '\n';
+  for (const auto word : k.arena) out << word << ' ';
+  out << '\n';
+  for (const auto value : k.values) out << static_cast<int>(value) << ' ';
+  out << '\n';
+  for (const auto id : k.unit_ids) out << id << ' ';
+  out << '\n';
+  for (const auto mark : k.factor_marks) out << static_cast<int>(mark) << ' ';
+  out << '\n';
+  for (Lit lit = 0; lit < 2*k.nvars; ++lit) {
+    out << lit << ':';
+    for (const WatchEntry w : k.watches.entries(lit))
+      if (w.binary()) out << 'b' << w.other() << ',';
+      else out << 'l' << w.ref() << ',';
+    out << '\n';
+  }
+}
+
+int main() {
+  char pattern[] = "/tmp/tactix-congruence-stages-XXXXXX";
+  const char *dir = mkdtemp(pattern);
+  assert(dir);
+  std::string paths[3];
+  for (int i = 0; i != 3; ++i) {
+    paths[i] = std::string(dir) + "/case" + std::to_string(i);
+    const pid_t child = fork();
+    assert(child >= 0);
+    if (!child) { run_case(paths[i], i-1); std::exit(0); }
+    int status = 0;
+    assert(waitpid(child, &status, 0) == child);
+    assert(WIFEXITED(status) && WEXITSTATUS(status) == 0);
+  }
+  assert(!read(paths[0]+".state").empty());
+  for (int i : {1,2}) {
+    assert(read(paths[0]+".state") == read(paths[i]+".state"));
+    assert(read(paths[0]+".proof") == read(paths[i]+".proof"));
+  }
+  assert(read(paths[0]+".trace").empty());
+#ifdef TACTIX_ENABLE_EVENT_TRACE
+  const char *stages[] = {"entry", "post-binary-extraction", "installed", "gates-built", "exit"};
+  std::istringstream trace(read(paths[1]+".trace"));
+  std::string line;
+  unsigned frame = 0;
+  while (std::getline(trace, line)) {
+    if (line.find("\tboundary\t") == std::string::npos) continue;
+    assert(frame < 5);
+    const std::string expected = std::string("tactix\tboundary\t") + stages[frame] +
+        "\t7\t" + (frame < 2 ? "1" : "2") + "\t";
+    assert(line.rfind(expected,0) == 0);
+    ++frame;
+  }
+  assert(frame == 5);
+  assert(read(paths[2]+".trace").find("\tboundary\t") == std::string::npos);
+#else
+  assert(read(paths[1]+".trace").empty() && read(paths[2]+".trace").empty());
+#endif
+  for (const auto &base : paths)
+    for (const char *suffix : {".state", ".proof", ".trace"})
+      std::remove((base + suffix).c_str());
+  assert(rmdir(dir) == 0);
+  std::puts("PASS: actual Congruence selected/disabled/wrong-conflict stages, state and proof identity");
+}
