+++ /home/hwu/SAT-solving/tools/solvers/variants/kissat-removal-clause-6262/src/eventtrace.c	2026-09-09 03:21:30.696314464 -0400
@@ -14,0 +15,42 @@
+// Standalone pre-deletion observation; never writes solver state.  Keep it
+// independent of the broad event logger and its payload truncation limits.
+static void observe_removed_clause (kissat *solver, clause *c,
+                                    const char *source) {
+  static bool initialized;
+  static FILE *out;
+  static uint64_t conflict;
+  static unsigned external;
+  if (!initialized) {
+    initialized = true;
+    const char *path = getenv ("KISSAT_REMOVED_CLAUSE_TRACE");
+    const char *at = getenv ("SAT_REMOVED_CLAUSE_CONFLICT");
+    const char *var = getenv ("SAT_REMOVED_CLAUSE_EXTERNAL");
+    if (path && at && var) {
+      conflict = strtoull (at, 0, 10);
+      external = strtoul (var, 0, 10);
+      out = fopen (path, "w");
+      if (!out) exit (2);
+      setvbuf (out, 0, _IOLBF, 0);
+    }
+  }
+  if (!out || solver->statistics.conflicts != conflict) return;
+  bool selected = false;
+  for (all_literals_in_clause (lit, c))
+    if ((unsigned) abs (kissat_export_literal (solver, lit)) == external)
+      selected = true;
+  if (!selected) return;
+  fprintf (out, "kissat\tconflicts=%llu\tdecisions=%llu\tsource=%s\tredundant=%u\tsize=%u\tliterals=",
+           (unsigned long long) solver->statistics.conflicts,
+           (unsigned long long) solver->statistics.decisions,
+           source, c->redundant, c->size);
+  for (all_literals_in_clause (lit, c))
+    fprintf (out, "%d,", kissat_export_literal (solver, lit));
+  fputs ("\tvalues=", out);
+  for (all_literals_in_clause (lit, c))
+    fprintf (out, "%d,", (int) solver->values[lit]);
+  fputs ("\teliminate=", out);
+  for (all_literals_in_clause (lit, c))
+    fprintf (out, "%u,", solver->flags[IDX (lit)].eliminate);
+  fputc ('\n', out);
+}
+
@@ -1712,0 +1755 @@
+  observe_removed_clause (solver, c, source);
