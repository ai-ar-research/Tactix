+  assert(result == (refute ? ApplyResult::Unsat : ApplyResult::Ok));
+  assert(k.inconsistent == refute && !k.conflict_valid);
+  assert(k.propagate_head == (refute ? 1u : 2u) && k.stats.propagations ==
