diff --git a/src/rules/lucky/graph_labeling_recognition.hpp b/src/rules/lucky/graph_labeling_recognition.hpp
new file mode 100644
index 00000000..17a3c791
--- /dev/null
+++ b/src/rules/lucky/graph_labeling_recognition.hpp
@@ -0,0 +1,147 @@
+#pragma once
+
+#include "kernel/kernel.hpp"
+
+#include <algorithm>
+#include <cstdint>
+#include <utility>
+#include <vector>
+
+namespace tactix::graph_labeling {
+
+// A heuristic projection, never a logical certificate. The indexed rectangle
+// follows the reference encoding: external identity row*N+column selects the
+// vertex at that label. Signs are recovered from the column-cover clauses.
+// Arbitrary renamings without this rectangle are conservatively unsupported.
+struct Shape {
+  uint32_t vertices = 0;
+  uint32_t separation = 0;
+  std::vector<Lit> primary;
+  std::vector<std::pair<uint32_t, uint32_t>> edges;
+  std::vector<std::vector<uint32_t>> adjacency;
+};
+
+// Charge includes clause/watch inspection, mapping/element initialization and
+// graph materialization. maximum_bytes bounds logical workspace payload,
+// excluding allocator overhead and the caller's already-owned Kernel/output.
+// Failure publishes no partial shape and never changes Kernel or proof state.
+template<class Charge>
+bool recognize(const Kernel &k, uint32_t maximum_vertices,
+               uint64_t maximum_bytes, Charge &&charge, Shape &out) {
+  out = {};
+  Shape shape;
+  uint32_t n = 0;
+  const uint64_t external_variables = k.external_to_internal.size();
+  // A cheap first pass selects a possible dimension from an indexed column.
+  // Full coverage and distinct rows are checked before the result is exposed.
+  for (Ref ref = 0; ref < k.arena.size();) {
+    const Clause *clause = clause_at(k.arena, ref);
+    if (!charge(1)) return false;
+    const uint32_t width = clause->size;
+    if (!clause->garbage() && !clause->redundant() && width >= 3 &&
+        width > n && width <= maximum_vertices &&
+        uint64_t(width) * width <= external_variables) {
+      uint32_t column = UINT32_MAX;
+      bool plausible = true;
+      for (Lit lit : *clause) {
+        if (!charge(1)) return false;
+        const Var external = k.internal_to_external[var_of(lit)];
+        if (uint64_t(external) >= uint64_t(width) * width ||
+            (column != UINT32_MAX && external % width != column)) {
+          plausible = false;
+          break;
+        }
+        column = external % width;
+      }
+      if (plausible) n = width;
+    }
+    ref += clause_actual_words(clause);
+  }
+  if (!n) return false;
+  const uint64_t square = uint64_t(n) * n;
+  // Primary literals, edge bitmap, fully reserved edge/adjacency vectors,
+  // row/column marks, and vector descriptors fit this conservative bound.
+  if (square > (UINT64_MAX - uint64_t(n) * 64) / 16 ||
+      square * 16 + uint64_t(n) * 64 > maximum_bytes ||
+      square > SIZE_MAX / sizeof(Lit) || !charge(square + 2 * uint64_t(n)))
+    return false;
+  shape.primary.assign(static_cast<size_t>(square), INVALID_LIT);
+  std::vector<uint8_t> columns(n, 0), rows(n, 0);
+  for (Ref ref = 0; ref < k.arena.size();) {
+    const Clause *clause = clause_at(k.arena, ref);
+    if (!charge(1)) return false;
+    if (!clause->garbage() && !clause->redundant() && clause->size == n) {
+      if (!charge(n)) return false;
+      std::fill(rows.begin(), rows.end(), 0);
+      uint32_t column = UINT32_MAX;
+      bool indexed = true;
+      for (Lit lit : *clause) {
+        if (!charge(1)) return false;
+        const Var external = k.internal_to_external[var_of(lit)];
+        if (external >= square || rows[external / n] ||
+            (column != UINT32_MAX && external % n != column)) {
+          indexed = false;
+          break;
+        }
+        rows[external / n] = 1;
+        column = external % n;
+      }
+      if (indexed) {
+        for (Lit lit : *clause) {
+          if (!charge(1)) return false;
+          const Var external = k.internal_to_external[var_of(lit)];
+          Lit &entry = shape.primary[external];
+          if (kernel_var_retired(k, var_of(lit)) ||
+              (entry != INVALID_LIT && entry != lit))
+            return false;
+          entry = lit;
+        }
+        columns[column] = 1;
+      }
+    }
+    ref += clause_actual_words(clause);
+  }
+  for (uint8_t present : columns) {
+    if (!charge(1) || !present) return false;
+  }
+  if (!charge(square)) return false;
+  std::vector<uint8_t> connected(static_cast<size_t>(square), 0);
+  uint32_t separation = n + 1;
+  for (Lit lit = 0; lit < 2 * k.nvars; ++lit) {
+    if (!charge(1)) return false;
+    const Var first = k.internal_to_external[var_of(lit)];
+    if (first >= square || lit != negate(shape.primary[first])) continue;
+    for (WatchEntry watch : k.watches.entries(lit)) {
+      if (!charge(1)) return false;
+      if (!watch.binary() || lit >= watch.other()) continue;
+      const Var second = k.internal_to_external[var_of(watch.other())];
+      if (second >= square ||
+          watch.other() != negate(shape.primary[second]) ||
+          first % n != second % n || first / n == second / n)
+        continue;
+      const uint32_t a = std::min(first / n, second / n);
+      const uint32_t b = std::max(first / n, second / n);
+      connected[uint64_t(a) * n + b] = 1;
+      separation = std::min(separation, first % n + 1);
+    }
+  }
+  if (separation > n || !charge(square + n)) return false;
+  shape.edges.reserve(static_cast<size_t>(square - n) / 2);
+  shape.adjacency.resize(n);
+  for (auto &row : shape.adjacency) row.reserve(n - 1);
+  for (uint32_t a = 0; a < n; ++a) {
+    for (uint32_t b = a + 1; b < n; ++b) {
+      if (!charge(1)) return false;
+      if (!connected[uint64_t(a) * n + b]) continue;
+      shape.edges.emplace_back(a, b);
+      shape.adjacency[a].push_back(b);
+      shape.adjacency[b].push_back(a);
+    }
+  }
+  shape.vertices = n;
+  shape.separation = separation;
+  out = std::move(shape);
+  return true;
+}
+
+} // namespace tactix::graph_labeling
diff --git a/src/rules/lucky/graph_labeling_search.hpp b/src/rules/lucky/graph_labeling_search.hpp
new file mode 100644
index 00000000..f7fcb585
--- /dev/null
+++ b/src/rules/lucky/graph_labeling_search.hpp
@@ -0,0 +1,273 @@
+#pragma once
+
+#include "rules/lucky/graph_labeling_recognition.hpp"
+
+#include <numeric>
+#include <random>
+
+namespace tactix::graph_labeling {
+
+using Score = std::pair<uint64_t, uint64_t>; // violated edges, squared deficits
+struct Candidate {
+  // Zero-based label for each vertex. No Boolean auxiliary values are implied.
+  std::vector<uint32_t> labels;
+  Score score{UINT64_MAX, UINT64_MAX};
+};
+
+// Stable metered insertion sorting keeps interruption outside a standard-library
+// comparator. Its degree/index ordering is the reference BFS tie break.
+template<class Less, class Charge>
+bool order_vertices(std::vector<uint32_t> &vertices, Less &&less, Charge &charge) {
+  for (size_t i = 1; i < vertices.size(); ++i) {
+    const uint32_t vertex = vertices[i];
+    size_t j = i;
+    while (j) {
+      if (!charge(1)) return false;
+      if (!less(vertex, vertices[j - 1])) break;
+      vertices[j] = vertices[j - 1];
+      --j;
+    }
+    vertices[j] = vertex;
+  }
+  return true;
+}
+
+template<class Charge>
+bool breadth_first_order(const Shape &shape, bool high_start, Charge &charge,
+                         std::vector<uint32_t> &order) {
+  const uint32_t n = shape.vertices;
+  if (!charge(3 * uint64_t(n))) return false;
+  std::vector<uint32_t> starts(n), pending;
+  std::vector<uint8_t> seen(n, 0);
+  pending.reserve(n);
+  order.clear();
+  order.reserve(n);
+  std::iota(starts.begin(), starts.end(), 0);
+  const auto degree_less = [&](uint32_t a, uint32_t b, bool high) {
+    const size_t da = shape.adjacency[a].size(), db = shape.adjacency[b].size();
+    return da == db ? a < b : high ? da > db : da < db;
+  };
+  if (!order_vertices(starts, [&](uint32_t a, uint32_t b) {
+        return degree_less(a, b, high_start);
+      }, charge)) return false;
+  std::vector<uint32_t> neighbors;
+  for (uint32_t start : starts) {
+    if (!charge(1)) return false;
+    if (seen[start]) continue;
+    pending.clear();
+    pending.push_back(start);
+    seen[start] = 1;
+    for (size_t head = 0; head < pending.size(); ++head) {
+      if (!charge(1)) return false;
+      const uint32_t vertex = pending[head];
+      order.push_back(vertex);
+      neighbors.clear();
+      for (uint32_t other : shape.adjacency[vertex]) {
+        if (!charge(1)) return false;
+        if (!seen[other]) neighbors.push_back(other);
+      }
+      if (!order_vertices(neighbors, [&](uint32_t a, uint32_t b) {
+            return degree_less(a, b, false);
+          }, charge)) return false;
+      for (uint32_t other : neighbors) {
+        if (!charge(1)) return false;
+        seen[other] = 1;
+        pending.push_back(other);
+      }
+    }
+  }
+  return true;
+}
+
+template<class Charge>
+bool score_labels(const Shape &shape, const std::vector<uint32_t> &labels,
+                  Charge &charge, Score &out) {
+  Score score{0, 0};
+  for (const auto [a, b] : shape.edges) {
+    if (!charge(1)) return false;
+    const uint32_t distance = labels[a] > labels[b] ? labels[a] - labels[b]
+                                                         : labels[b] - labels[a];
+    if (distance < shape.separation) {
+      ++score.first;
+      const uint64_t deficit = shape.separation - distance;
+      score.second += deficit * deficit;
+    }
+  }
+  out = score;
+  return true;
+}
+
+// The reference's complete 2*2*3*2 construction family: low/high-degree BFS
+// starts, forward/reverse order, alternating ends/two-at-a-time/straight labels,
+// and reflection. A bounded stop retains only fully scored candidates.
+// Shape must come from recognize (or an equivalently validated internal graph).
+// Caller separately admits workspace: O(vertices+edges), no kernel mutation.
+template<class Charge>
+bool order_seeds(const Shape &shape, Charge &&charge, Candidate &best,
+                 uint32_t &completed) {
+  best = {};
+  completed = 0;
+  const uint32_t n = shape.vertices;
+  if (!n || shape.adjacency.size() != n) return false;
+  for (bool high : {false, true}) {
+    std::vector<uint32_t> order;
+    if (!breadth_first_order(shape, high, charge, order)) return false;
+    for (bool reverse : {false, true}) {
+      for (uint32_t mode = 0; mode < 3; ++mode) {
+        for (bool flip : {false, true}) {
+          if (!charge(n)) return false;
+          std::vector<uint32_t> labels(n);
+          uint32_t low = 0, high_label = n - 1;
+          for (uint32_t i = 0; i < n; ++i) {
+            const uint32_t vertex = order[reverse ? n - 1 - i : i];
+            if (mode == 2) labels[vertex] = flip ? n - 1 - i : i;
+            else {
+              const bool from_low = (((mode == 0 ? i : i / 2) & 1) == 0) != flip;
+              labels[vertex] = from_low ? low++ : high_label--;
+            }
+          }
+          if (labels[0] + 1 > n / 2) {
+            if (!charge(n)) return false;
+            for (auto &label : labels) label = n - 1 - label;
+          }
+          Score score;
+          if (!score_labels(shape, labels, charge, score)) return false;
+          ++completed;
+          if (score < best.score) {
+            best.labels = std::move(labels);
+            best.score = score;
+          }
+        }
+      }
+    }
+  }
+  return true;
+}
+
+struct WindowLimits {
+  uint64_t nodes;
+  uint32_t starts;
+  uint32_t early_choices;
+  uint64_t seed;
+};
+enum class WindowStatus { Found, NoCandidate, Limited };
+
+// Place one vertex at each successive label, excluding neighbors of the last
+// separation-1 vertices. Explicit frames avoid recursion on a caller-sized
+// graph. A frame ranks candidates by remaining degree times the number of
+// recent vertices, then descending total degree, matching the reference key
+// without re-counting the same neighbors for each recent vertex. Random ties
+// are stable in shuffled order. Caps/seed belong to the caller's typed profile.
+// On a bounded stop the prior fully scored construction remains available.
+template<class Charge>
+WindowStatus window_search(const Shape &shape, const WindowLimits &limits,
+                           Charge &&charge, Candidate &best, uint64_t &nodes) {
+  nodes = 0;
+  const uint32_t n = shape.vertices;
+  if (!n || !shape.separation || shape.adjacency.size() != n)
+    return WindowStatus::NoCandidate;
+  if (!limits.nodes || !limits.starts || !limits.early_choices)
+    return WindowStatus::Limited;
+  const uint64_t words = (uint64_t(n) + 63) / 64;
+  if (!charge(uint64_t(n) * words + 3 * uint64_t(n)))
+    return WindowStatus::Limited;
+  std::vector<std::vector<uint64_t>> adjacent(n, std::vector<uint64_t>(words, 0));
+  std::vector<uint32_t> starts(n), order;
+  std::vector<uint8_t> used(n, 0);
+  std::iota(starts.begin(), starts.end(), 0);
+  order.reserve(n);
+  for (uint32_t v = 0; v < n; ++v)
+    for (uint32_t u : shape.adjacency[v]) {
+      if (!charge(1)) return WindowStatus::Limited;
+      adjacent[v][u / 64] |= uint64_t{1} << (u % 64);
+    }
+  if (!order_vertices(starts, [&](uint32_t a, uint32_t b) {
+        const size_t da = shape.adjacency[a].size(), db = shape.adjacency[b].size();
+        return da == db ? a < b : da > db;
+      }, charge)) return WindowStatus::Limited;
+  struct Frame { std::vector<uint32_t> choices; size_t next = 0; };
+  std::vector<Frame> frames;
+  frames.reserve(n);
+  std::mt19937_64 random(limits.seed);
+  std::vector<uint64_t> forbidden(words), remaining_degree(n);
+  for (uint32_t si = 0; si < std::min(n, limits.starts); ++si) {
+    if (!charge(n)) return WindowStatus::Limited;
+    std::fill(used.begin(), used.end(), 0);
+    order.assign(1, starts[si]);
+    used[starts[si]] = 1;
+    frames.clear();
+    bool enter = true;
+    while (!order.empty()) {
+      if (enter) {
+        if (nodes == limits.nodes || !charge(1)) return WindowStatus::Limited;
+        ++nodes;
+        const uint32_t depth = static_cast<uint32_t>(order.size());
+        if (depth == n) {
+          if (!charge(n)) return WindowStatus::Limited;
+          Candidate candidate;
+          candidate.labels.resize(n);
+          for (uint32_t i = 0; i < n; ++i) candidate.labels[order[i]] = i;
+          if (candidate.labels[0] + 1 > n / 2) {
+            if (!charge(n)) return WindowStatus::Limited;
+            for (auto &label : candidate.labels) label = n - 1 - label;
+          }
+          if (!score_labels(shape, candidate.labels, charge, candidate.score))
+            return WindowStatus::Limited;
+          best = std::move(candidate);
+          return WindowStatus::Found;
+        }
+        if (!charge(words)) return WindowStatus::Limited;
+        std::fill(forbidden.begin(), forbidden.end(), 0);
+        const uint32_t first = depth >= shape.separation
+                                   ? depth - shape.separation + 1 : 0;
+        for (uint32_t i = first; i < depth; ++i)
+          for (uint64_t word = 0; word < words; ++word) {
+            if (!charge(1)) return WindowStatus::Limited;
+            forbidden[word] |= adjacent[order[i]][word];
+          }
+        Frame frame;
+        for (uint32_t v = 0; v < n; ++v) {
+          if (!charge(1)) return WindowStatus::Limited;
+          if (used[v] || (forbidden[v / 64] & (uint64_t{1} << (v % 64)))) continue;
+          frame.choices.push_back(v);
+          remaining_degree[v] = 0;
+          for (uint32_t u : shape.adjacency[v]) {
+            if (!charge(1)) return WindowStatus::Limited;
+            remaining_degree[v] += !used[u];
+          }
+        }
+        // Fisher-Yates with an explicit draw per choice keeps replay stable.
+        for (size_t i = frame.choices.size(); i > 1; --i) {
+          if (!charge(1)) return WindowStatus::Limited;
+          std::swap(frame.choices[i - 1], frame.choices[random() % i]);
+        }
+        const uint32_t recent = std::min(depth, shape.separation >= 2
+                                                     ? shape.separation - 2 : 0);
+        if (!order_vertices(frame.choices, [&](uint32_t a, uint32_t b) {
+              const uint64_t ra = remaining_degree[a] * recent;
+              const uint64_t rb = remaining_degree[b] * recent;
+              return ra != rb ? ra < rb
+                             : shape.adjacency[a].size() > shape.adjacency[b].size();
+            }, charge)) return WindowStatus::Limited;
+        if (depth < n / 3 && frame.choices.size() > limits.early_choices)
+          frame.choices.resize(limits.early_choices);
+        frames.push_back(std::move(frame));
+        enter = false;
+      }
+      Frame &frame = frames.back();
+      if (frame.next < frame.choices.size()) {
+        const uint32_t vertex = frame.choices[frame.next++];
+        order.push_back(vertex);
+        used[vertex] = 1;
+        enter = true;
+      } else {
+        frames.pop_back();
+        used[order.back()] = 0;
+        order.pop_back();
+      }
+    }
+  }
+  return WindowStatus::NoCandidate;
+}
+
+} // namespace tactix::graph_labeling
diff --git a/tests/test_graph_labeling_recognition.cpp b/tests/test_graph_labeling_recognition.cpp
new file mode 100644
index 00000000..a57d7cfc
--- /dev/null
+++ b/tests/test_graph_labeling_recognition.cpp
@@ -0,0 +1,92 @@
+#undef NDEBUG
+#include "rules/lucky/graph_labeling_recognition.hpp"
+#include "policies/heuristics.hpp"
+
+#include <cassert>
+#include <vector>
+
+using namespace tactix;
+
+// Indexed column covers with a sign-renamed Boolean encoding. The graph
+// exclusions begin in column two (one-based separation three), as in the
+// reference's interval encoding. This is only a recognition fixture, not a
+// full Boolean encoding of graph labeling.
+static void rectangle(Kernel &k, bool signed_encoding, bool malformed = false) {
+  constexpr uint32_t n = 4;
+  kernel_reserve_vars(k, n * n + 2);
+  const auto primary = [&](Var v) {
+    return make_lit(v, signed_encoding && (v % 3 == 0));
+  };
+  for (uint32_t column = 0; column < n; ++column) {
+    std::vector<Lit> cover;
+    for (uint32_t row = 0; row < n; ++row)
+      cover.push_back(primary(row * n + column));
+    if (malformed && column == 1) cover[0] = primary(2);
+    std::reverse(cover.begin(), cover.end());
+    kernel_add_large_clause(k, cover.data(), cover.size(), false, 0);
+  }
+  for (uint32_t column = 2; column < n; ++column) {
+    kernel_add_binary_clause(k, negate(primary(column)),
+                             negate(primary(n + column)));
+    kernel_add_binary_clause(k, negate(primary(n + column)),
+                             negate(primary(2 * n + column)));
+  }
+}
+
+int main() {
+  for (bool signs : {false, true}) {
+    Kernel k;
+    rectangle(k, signs);
+    const auto trail = k.trail;
+    uint64_t work = 0;
+    graph_labeling::Shape shape;
+    const auto count = [&](uint64_t amount) { work += amount; return true; };
+    assert(graph_labeling::recognize(k, 4, 1024, count, shape));
+    assert(shape.vertices == 4 && shape.separation == 3);
+    assert((shape.edges == std::vector<std::pair<uint32_t, uint32_t>>{
+                               {0, 1}, {1, 2}}));
+    assert((shape.adjacency[1] == std::vector<uint32_t>{0, 2}));
+    for (Var v = 0; v < 16; ++v)
+      assert(shape.primary[v] == make_lit(v, signs && v % 3 == 0));
+    const uint64_t complete_work = work;
+    for (uint64_t limit = 0; limit < complete_work; ++limit) {
+      uint64_t used = 0;
+      const auto bounded = [&](uint64_t amount) {
+        if (amount > limit - used) return false;
+        used += amount;
+        return true;
+      };
+      assert(!graph_labeling::recognize(k, 4, 1024, bounded, shape));
+      assert(!shape.vertices && shape.primary.empty() && shape.edges.empty());
+      assert(used <= limit && k.trail == trail);
+    }
+    assert(!graph_labeling::recognize(k, 3, 1024, count, shape));
+    assert(!graph_labeling::recognize(k, 4, 1, count, shape));
+    assert(k.trail == trail);
+  }
+  {
+    Kernel k;
+    rectangle(k, false, true);
+    graph_labeling::Shape shape;
+    assert(!graph_labeling::recognize(k, 4, 1024,
+                                      [](uint64_t) { return true; }, shape));
+  }
+  {
+    Kernel k;
+    ScopedHeuristics h(k);
+    rectangle(k, true);
+    k.var_status.assign(k.nvars, VarStatus::Active);
+    k.var_status[16] = VarStatus::Eliminated;
+    heuristics_deactivate_var(k, 16);
+    --k.unassigned_active;
+    assert(kernel_compact_variables(k));
+    graph_labeling::Shape shape;
+    const auto charge = [](uint64_t) { return true; };
+    assert(graph_labeling::recognize(k, 4, 1024, charge, shape));
+    k.var_status.resize(k.nvars, VarStatus::Active);
+    const Var internal = k.external_to_internal[2];
+    assert(internal < k.nvars);
+    k.var_status[internal] = VarStatus::Eliminated;
+    assert(!graph_labeling::recognize(k, 4, 1024, charge, shape));
+  }
+}
diff --git a/tests/test_graph_labeling_search.cpp b/tests/test_graph_labeling_search.cpp
new file mode 100644
index 00000000..4008cda3
--- /dev/null
+++ b/tests/test_graph_labeling_search.cpp
@@ -0,0 +1,107 @@
+#undef NDEBUG
+#include "rules/lucky/graph_labeling_search.hpp"
+
+#include <cassert>
+#include <numeric>
+
+using namespace tactix::graph_labeling;
+
+static Score independent_score(const Shape &shape, const Candidate &candidate) {
+  auto sorted = candidate.labels;
+  std::sort(sorted.begin(), sorted.end());
+  for (uint32_t i = 0; i < shape.vertices; ++i) assert(sorted[i] == i);
+  uint64_t bad = 0, penalty = 0;
+  for (uint32_t v = 0; v < shape.vertices; ++v)
+    for (uint32_t u : shape.adjacency[v]) {
+      if (u <= v) continue;
+      const int64_t distance = std::abs(int64_t(candidate.labels[v]) -
+                                       int64_t(candidate.labels[u]));
+      if (distance >= shape.separation) continue;
+      ++bad;
+      const uint64_t deficit = shape.separation - distance;
+      penalty += deficit * deficit;
+    }
+  return {bad, penalty};
+}
+
+int main() {
+  // Exhaust every simple four-vertex graph, including disconnected graphs and
+  // an impossible separation. Check complete permutations and objective values
+  // independently of the constructor's edge scorer, plus deterministic replay.
+  for (uint32_t mask = 0; mask < 64; ++mask) {
+    Shape shape;
+    shape.vertices = 4;
+    shape.separation = 3;
+    shape.adjacency.resize(4);
+    uint32_t bit = 0;
+    for (uint32_t a = 0; a < 4; ++a)
+      for (uint32_t b = a + 1; b < 4; ++b, ++bit)
+        if (mask & (1u << bit)) {
+          shape.edges.emplace_back(a, b);
+          shape.adjacency[a].push_back(b);
+          shape.adjacency[b].push_back(a);
+        }
+    Candidate candidate;
+    uint64_t work = 0;
+    const auto charge = [&](uint64_t amount) { work += amount; return true; };
+    uint32_t completed = 0;
+    assert(order_seeds(shape, charge, candidate, completed));
+    assert(completed == 24 && candidate.score == independent_score(shape, candidate));
+    Candidate replay;
+    assert(order_seeds(shape, charge, replay, completed));
+    assert(replay.labels == candidate.labels && replay.score == candidate.score);
+    // With all starts/choices allowed this finite search must agree with a
+    // brute-force permutation oracle, even when the seed family misses a model.
+    Candidate brute;
+    brute.labels = {0, 1, 2, 3};
+    bool exists = false;
+    do {
+      exists |= independent_score(shape, brute).first == 0;
+    } while (std::next_permutation(brute.labels.begin(), brute.labels.end()));
+    Candidate searched = candidate;
+    uint64_t nodes = 0;
+    const WindowLimits limits{1000, 4, 4, 123};
+    const auto unbounded = [](uint64_t) { return true; };
+    const auto status = window_search(shape, limits, unbounded, searched, nodes);
+    assert((status == WindowStatus::Found) == exists);
+    assert(status != WindowStatus::Limited && nodes <= limits.nodes);
+    if (exists) {
+      assert(searched.score.first == 0);
+      assert(searched.score == independent_score(shape, searched));
+    } else assert(searched.labels == candidate.labels);
+    if (!mask) {
+      uint64_t dfs_work = 0;
+      const auto dfs_count = [&](uint64_t amount) { dfs_work += amount; return true; };
+      assert(window_search(shape, limits, dfs_count, searched, nodes) == WindowStatus::Found);
+      for (uint64_t limit = 0; limit < dfs_work; ++limit) {
+        uint64_t used = 0;
+        const auto bounded = [&](uint64_t amount) {
+          if (amount > limit - used) return false;
+          used += amount;
+          return true;
+        };
+        searched = candidate;
+        assert(window_search(shape, limits, bounded, searched, nodes) == WindowStatus::Limited);
+        assert(searched.labels == candidate.labels && searched.score == candidate.score);
+      }
+    }
+    if (mask == 0) assert(candidate.score.first == 0);
+    if (mask != 63) continue;
+    // Every possible early stop retains an evaluated permutation, never an
+    // interrupted sort or a half-built assignment.
+    const uint64_t full_work = work / 2;
+    for (uint64_t limit = 0; limit < full_work; ++limit) {
+      uint64_t used = 0;
+      const auto bounded = [&](uint64_t amount) {
+        if (amount > limit - used) return false;
+        used += amount;
+        return true;
+      };
+      Candidate partial;
+      assert(!order_seeds(shape, bounded, partial, completed));
+      assert(used <= limit && completed < 24);
+      if (completed) assert(partial.score == independent_score(shape, partial));
+      else assert(partial.labels.empty());
+    }
+  }
+}
