+// Exercise actual Factor first/repeated visits across touched-vector growth.
+#undef NDEBUG
+#include "kernel/kernel.hpp"
+#include "policies/heuristics.hpp"
+#include "rules/factor/factor.hpp"
+#include <algorithm>
+#include <cassert>
+#include <cstdio>
+#include <vector>
+
+using namespace tactix;
+static uint64_t digest = 1469598103934665603ULL;
+static void mix(uint64_t x) { digest = (digest ^ x) * 1099511628211ULL; }
+
+struct Counts final : FactorSelection {
+  unsigned rows, columns, visits = 0;
+  Counts(unsigned m, unsigned n) : rows(m), columns(n) {}
+  double seed_score(const Kernel &, Lit, double score) override { return score; }
+  double next_factor_score(const Kernel &, Lit lit, uint32_t count, Lit seed,
+                           double score) override {
+    assert(var_of(lit) < rows && lit != seed);
+    assert(count == columns); // every first visit and subsequent increment
+    mix(lit); mix(count); mix(seed); mix(static_cast<uint64_t>(score));
+    ++visits;
+    return score;
+  }
+  bool accept(uint32_t m, uint32_t n, int delta) override {
+    assert(m <= rows && n == columns);
+    assert(delta == static_cast<int>(m*n-m-n));
+    return delta > 0;
+  }
+};
+
+static void image(const Kernel &k) {
+  mix(k.nvars); mix(k.first_extension_var); mix(k.next_clause_id);
+  mix(k.factor_completed); mix(k.stats.factorings); mix(k.stats.factor_ticks);
+  mix(k.stats.factor_large_remainders); mix(k.stats.ticks);
+  mix(k.large_watches_connected); mix(k.watches.holes);
+  mix(k.watches.arena.size()); mix(k.watches.arena.capacity());
+  for (uint32_t word : k.watches.arena) mix(word);
+  for (const WatchHead &h : k.watches.heads) {
+    mix(h.offset); mix(h.size); mix(h.capacity); mix(h.binary_count_and_order);
+  }
+  mix(k.arena.size());
+  for (uint32_t word : k.arena) mix(word);
+  for (const auto mark : k.factor_marks) mix(mark);
+  for (const auto value : k.values) mix(static_cast<uint8_t>(value));
+  mix(k.propagate_head); mix(k.trail.size());
+  for (Lit lit : k.trail) mix(lit);
+  for (Ref ref = 0; ref < k.arena.size();) {
+    const Clause *c = clause_at(k.arena, ref);
+    assert(!(c->flags & (Clause::FACTOR_RESERVED | Clause::FACTOR_USED)));
+    ref += clause_actual_words(c);
+  }
+}
+
+static void exercise(unsigned rows, unsigned columns, unsigned width,
+                     bool reverse, uint64_t budget) {
+  Kernel k;
+  ScopedHeuristics heuristics(k);
+  const unsigned original = rows + columns*width;
+  kernel_reserve_vars(k, original);
+  k.factor_size = width+1;
+  k.work_budget = budget;
+  Counts counts(rows, columns);
+  k.factor_selection = &counts;
+  for (unsigned i = 0; i < rows; ++i)
+    for (unsigned j = 0; j < columns; ++j) {
+      const unsigned row = reverse ? rows-1-i : i;
+      const unsigned col = reverse ? columns-1-j : j;
+      std::vector<Lit> clause{make_lit(row, false)};
+      for (unsigned r = 0; r < width; ++r)
+        clause.push_back(make_lit(rows+col*width+r, r&1));
+      if (reverse) std::reverse(clause.begin(), clause.end());
+      const uint64_t id = ++k.next_clause_id;
+      if (width == 1)
+        kernel_add_binary_clause(k, clause[0], clause[1], id);
+      else
+        kernel_add_large_clause(k, clause.data(), clause.size(), false, 0, id);
+    }
+  const auto &rule = tactix_rules()[tactix_rule_id("Factor")];
+  const ApplyResult result = rule.apply_instance(k, lit_instance(k, make_lit(0, false)));
+  assert(result == ApplyResult::Ok || result == ApplyResult::NoOp);
+  if (!budget) {
+    assert(result == ApplyResult::Ok && k.stats.factorings == 1);
+    assert(k.nvars == original+1 && counts.visits >= rows-1);
+    assert(kernel_num_output_vars(k) == original);
+    const Lit x = make_lit(original, false), nx = x^1;
+    assert(k.watches.heads[x].binary_count() == rows);
+    if (width == 1) assert(k.watches.heads[nx].binary_count() == columns);
+  }
+  mix(rows); mix(columns); mix(width); mix(reverse); mix(budget);
+  mix(static_cast<unsigned>(result)); mix(counts.visits); image(k);
+  // A subsequent call reconstructs fresh apply-local count/mark scratch.
+  k.work_budget = 0;
+  counts.visits = 0;
+  const ApplyResult second = rule.apply_instance(k, lit_instance(k, make_lit(0, false)));
+  assert(second == ApplyResult::Ok || second == ApplyResult::NoOp);
+  mix(static_cast<unsigned>(second)); mix(counts.visits); image(k);
+  k.factor_selection = nullptr;
+}
+
+int main() {
+  unsigned cases = 0;
+  for (unsigned rows : {2u, 3u, 9u, 33u, 65u})
+    for (unsigned columns : {3u, 8u, 19u})
+      for (unsigned width : {1u, 2u, 4u})
+        for (bool reverse : {false, true})
+          for (uint64_t budget : {uint64_t{0}, uint64_t{4}, uint64_t{18}}) {
+            exercise(rows, columns, width, reverse, budget);
+            ++cases;
+          }
+  assert(cases == 270);
+  std::printf("factor-count: %u cases, digest %016llx\n", cases,
+              static_cast<unsigned long long>(digest));
+}
