@@ -1348,0 +1351,38 @@
+  void trace_full_heap(const char *stage, Var trigger) const {
+#ifdef TACTIX_ENABLE_EVENT_TRACE
+    const char *path = std::getenv("TACTIX_BVE_FULL_HEAP_TRACE");
+    const char *conflict = std::getenv("SAT_BVE_FULL_HEAP_CONFLICT");
+    const char *subject = std::getenv("SAT_BVE_FULL_HEAP_EXTERNAL");
+    const Kernel &k = *kernel_;
+    if (!path || !*path || !conflict || !*conflict || !subject || !*subject ||
+        std::strtoull(conflict, nullptr, 10) != k.stats.conflicts)
+      return;
+    static bool initial_done = false, pop_done = false;
+    const bool initial = !std::strcmp(stage, "initial");
+    const uint32_t external = trigger == INVALID_VAR ? 0 : k.internal_to_external[trigger] + 1;
+    if (initial ? initial_done : (pop_done || external != std::strtoul(subject, nullptr, 10)))
+      return;
+    if (!initial && !initial_done) { std::fputs("missing BVE initial heap\n", stderr); std::exit(2); }
+    std::FILE *out = std::fopen(path, initial ? "w" : "a");
+    if (!out) { std::perror("TACTIX_BVE_FULL_HEAP_TRACE"); std::exit(2); }
+    if (initial) std::fputs("# bve-full-heap\t1\n", out);
+    std::fprintf(out, "# begin\t%u\t%s\t%llu\t%u\t%zu\n", initial ? 0 : 1,
+                 stage, (unsigned long long)k.stats.conflicts, external, stack_.size());
+    for (uint32_t i = 0; i < stack_.size(); ++i) {
+      const Var v = stack_[i];
+      std::fprintf(out, "%u\t%u\t%a\t%u\t%u\t%d\t%u\t%u\n", i,
+                   k.internal_to_external[v] + 1, score_[v],
+                   bve_schedule_occurrence_count(k, make_lit(v, false)),
+                   bve_schedule_occurrence_count(k, make_lit(v, true)),
+                   static_cast<int>(k.value(make_lit(v, false))),
+                   kernel_var_retired(k, v), static_cast<unsigned>(k.bve_retry[v]));
+    }
+    std::fprintf(out, "# end\t%u\n", initial ? 0 : 1);
+    const bool failed = std::ferror(out);
+    if (std::fclose(out) || failed) { std::fputs("BVE heap snapshot write failed\n", stderr); std::exit(2); }
+    if (initial) initial_done = true; else pop_done = true;
+#else
+    (void)stage; (void)trigger;
+#endif
+  }
+
