+// Compile/run in both modes: telemetry must not alter logical work or dispatch.
+#undef NDEBUG
+#include "kernel/kernel.hpp"
+#include "rules/registry.hpp"
+#include <cassert>
+#include <cstdio>
+using namespace tactix;
+
+static ApplyResult apply(Kernel &k) {
+  k.stats.ticks += 7;
+  return ApplyResult::NoOp;
+}
+static ApplyResult instance(Kernel &k, uint64_t i) {
+  k.stats.ticks += i;
+  return ApplyResult::Conflict;
+}
+
+static void dispatch() {
+  Kernel k;
+  RuleVTable r{"TelemetryFixture", RuleTier::Macro, nullptr, apply};
+  r.kind = ActionKind::PolicyOp;
+  r.apply_instance = instance;
+  for (uint32_t id : {0u, Stats::MAX_TIMED_RULES - 1,
+                      Stats::MAX_TIMED_RULES, UINT32_MAX}) {
+    r.id = id;
+    const auto before = k.stats.ticks;
+    assert(apply_rule(r, k) == ApplyResult::NoOp);
+    assert(apply_rule_instance(r, k, 11) == ApplyResult::Conflict);
+    assert(k.stats.ticks == before + 18);
+    if (id < Stats::MAX_TIMED_RULES) {
+      assert(k.stats.rule_calls[id] == 2);
+#ifdef TACTIX_DISABLE_RUNTIME_TELEMETRY
+      assert(k.stats.rule_nanos[id] == 0);
+#endif
+    }
+  }
+  assert(k.stats.rule_calls[0] == 2);
+  assert(k.stats.rule_calls[Stats::MAX_TIMED_RULES - 1] == 2);
+  assert(k.stats.inprocess_nanos == 0);
+}
+
+static void binary_scans(bool mixed, bool current_level) {
+  Kernel k;
+  kernel_reserve_vars(k, 4);
+  const Lit large[] = {internalize(-1), internalize(3), internalize(4)};
+  if (mixed) kernel_add_large_clause(k, large, 3, false, 0);
+  kernel_add_binary_clause(k, internalize(-1), internalize(2));
+  if (!mixed) kernel_add_large_clause(k, large, 3, false, 0);
+  assert(k.watches.heads[internalize(-1)].binaries_first() == !mixed);
+  k.tick_sink = &k.stats.backbone_ticks;
+  kernel_assign_decision(k, internalize(1));
+  const auto ticks = k.stats.ticks;
+  assert(!kernel_propagate_binary(k, current_level));
+  assert(k.value(internalize(2)) > 0);
+  assert(k.value(internalize(3)) == 0);
+  assert(k.value(internalize(4)) == 0);
+  assert(k.assigned[var_of(internalize(2))].level == 1);
+  assert(k.trail.size() == 2 && k.propagate_head == 2);
+  assert(!kernel_propagation_fixpoint(k));
+  assert(k.stats.ticks - ticks == 3);
+  assert(k.stats.backbone_ticks == 3);
+  assert(k.stats.propagations == 2);
+#ifdef TACTIX_DISABLE_RUNTIME_TELEMETRY
+  assert(k.stats.binprop_scans == 0 && k.stats.binprop_words == 0);
+  assert(k.stats.binprop_ordered == 0 && k.stats.binprop_large == 0);
+  assert(k.stats.binprop_flagged == 0 && k.stats.binprop_skipped == 0);
+#else
+  assert(k.stats.binprop_scans == 2);
+  assert(k.stats.binprop_words == (mixed ? 3 : 2));
+  assert(k.stats.binprop_large == (mixed ? 2 : 0));
+  assert(k.stats.binprop_flagged == (mixed ? 1 : 2));
+#endif
+  assert(!kernel_propagate(k));
+  assert(kernel_propagation_fixpoint(k));
+}
+
+int main() {
+  dispatch();
+  for (bool mixed : {false, true})
+    for (bool current : {false, true}) binary_scans(mixed, current);
+  std::puts("runtime-telemetry: four dispatch boundaries and four scan states PASS");
+}
