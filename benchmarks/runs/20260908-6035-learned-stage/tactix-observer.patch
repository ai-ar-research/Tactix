+static void emit_learned_stage(const Kernel &k, const char *event,
+                               const std::vector<Lit> &clause) {
+  if (!ls_begin(event, k.stats.conflicts, k.stats.decisions, k.level, clause.size()))
+    return;
+  for (size_t i = 0; i < clause.size(); ++i)
+    std::fprintf(ls_file, "%s%d", i ? "," : "", kernel_externalize(k, clause[i]));
+  ls_end();
+}
