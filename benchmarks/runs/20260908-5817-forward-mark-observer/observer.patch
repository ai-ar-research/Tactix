+// Diagnostic-only observation of the exact fixed-root notification boundary.
+// No stamps, counters, clauses or propagation cursors are modified here.
+static void trace_forward_root_marks(const Kernel &k, const char *stage) {
+  const char *path = std::getenv("TACTIX_FORWARD_MARK_TRACE");
+  const char *at = std::getenv("SAT_FORWARD_MARK_CONFLICT");
+  if (!path || !at || k.stats.conflicts != std::strtoull(at, nullptr, 10))
+    return;
+  const char *spec = std::getenv("TACTIX_EVENT_TRACE_FORWARD_CLAUSE");
+  if (!spec)
+    std::exit(2);
+  std::FILE *out = std::fopen(path, "a");
+  if (!out)
+    std::exit(2);
+  std::fprintf(out, "boundary\tstage=%s\tround=%llu\twatermark=%llu\t"
+                    "epoch=%llu\tfixed_head=%u\troot_fixed=%u\n",
+               stage, (unsigned long long)k.stats.strengthen_rounds,
+               (unsigned long long)k.strengthen_touch_mark,
+               (unsigned long long)k.touch_epoch, k.touch_fixed_head,
+               kernel_root_fixed(k));
+  while (*spec) {
+    char *end = nullptr;
+    const int external = static_cast<int>(std::strtol(spec, &end, 10));
+    if (end == spec || !external)
+      std::exit(2);
+    spec = end;
+    if (*spec == ',')
+      ++spec;
+    else if (*spec)
+      std::exit(2);
+    bool found = false;
+    for (Var v = 0; v < k.nvars; ++v) {
+      const Lit positive = make_lit(v, false);
+      if (kernel_externalize(k, positive) != std::abs(external))
+        continue;
+      const Lit lit = external < 0 ? negate(positive) : positive;
+      std::fprintf(out, "variable\texternal=%d\tvalue=%d\tstamp=%llu\t"
+                        "marked=%u\ttrail=%u\n", external, k.value(lit),
+                   (unsigned long long)k.touched[v],
+                   unsigned(kernel_touched_since(k, v, k.strengthen_touch_mark)),
+                   k.assigned[v].trail);
+      found = true;
+      break;
+    }
+    if (!found)
+      std::fprintf(out, "absent\texternal=%d\n", external);
+  }
+  std::fclose(out);
+}
