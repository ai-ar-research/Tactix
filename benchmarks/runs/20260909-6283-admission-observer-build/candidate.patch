+  // Observe the real return path and its inputs, including early refusals.
+  // The diagnostic owns no solver state and is absent from Release builds.
+  struct AdmissionObserver {
+    const Kernel &k;
+    const SlotClock &clock;
+    SlotGroup group;
+    bool initialized, preprocess, watermarks, answer = false;
+    ~AdmissionObserver() {
+      static bool configured = false;
+      static FILE *out = nullptr;
+      static uint64_t selected = 0;
+      if (!configured) {
+        configured = true;
+        const char *path = std::getenv("TACTIX_ELIMINATE_ADMISSION_TRACE");
+        const char *at = std::getenv("SAT_ELIMINATE_ADMISSION_CONFLICT");
+        if (path && at) {
+          selected = std::strtoull(at, nullptr, 10);
+          out = std::fopen(path, "w");
+          if (!out) std::exit(2);
+          std::setvbuf(out, nullptr, _IOLBF, 0);
+        }
+      }
+      if (!out || group != SlotGroup::Eliminate || k.stats.conflicts != selected)
+        return;
+      std::fprintf(out, "tactix\tconflicts=%llu\tdecisions=%llu\tanswer=%u\tinitialized=%u\tpreprocess=%u\twatermarks=%u\trounds=%llu\tdeadline=%llu\tmarks=%llu\tmarks_limit=%llu\tfixed=%llu\tfixed_limit=%llu\tblocked=%u\tepisodes=%llu\n",
