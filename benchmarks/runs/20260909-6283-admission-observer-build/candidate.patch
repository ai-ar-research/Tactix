+          (unsigned long long)k.stats.bve_marks, (unsigned long long)clock.marks_mark,
+          (unsigned long long)kernel_root_fixed(k), (unsigned long long)clock.fixed_mark,
+          clock.blocked, (unsigned long long)clock.blocked_episodes);
