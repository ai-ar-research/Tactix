+
+bool kissat_eliminating (kissat *solver) {
+  const bool answer = eliminating_without_observer (solver);
+  static bool configured;
+  static FILE *out;
+  static uint64_t selected;
+  if (!configured) {
+    configured = true;
+    const char *path = getenv ("KISSAT_ELIMINATE_ADMISSION_TRACE");
+    const char *at = getenv ("SAT_ELIMINATE_ADMISSION_CONFLICT");
+    if (path && at) {
+      selected = strtoull (at, 0, 10);
+      out = fopen (path, "w");
+      if (!out) exit (2);
+      setvbuf (out, 0, _IOLBF, 0);
+    }
+  }
+  if (out && solver->statistics.conflicts == selected)
+    fprintf (out, "kissat\tconflicts=%llu\tdecisions=%llu\tanswer=%u\tenabled=%u\tirredundant=%llu\tlast_reduce=%llu\tdeadline=%llu\teliminate=%llu\teliminate_limit=%llu\tsubsume=%llu\tsubsume_limit=%llu\n",
+        (unsigned long long) solver->statistics.conflicts,
+        (unsigned long long) solver->statistics.decisions, answer, solver->enabled.eliminate,
+        (unsigned long long) solver->statistics.clauses_irredundant,
+        (unsigned long long) solver->last.conflicts.reduce,
+        (unsigned long long) solver->limits.eliminate.conflicts,
+        (unsigned long long) solver->statistics.variables_eliminate,
+        (unsigned long long) solver->limits.eliminate.variables.eliminate,
+        (unsigned long long) solver->statistics.variables_subsume,
+        (unsigned long long) solver->limits.eliminate.variables.subsume);
+  return answer;
