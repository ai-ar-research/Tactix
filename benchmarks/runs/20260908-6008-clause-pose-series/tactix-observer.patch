+static void emit_clause_pose_series(const Kernel &k, const char *event,
+                                    const char *payload) {
+  if (!pose_series_begin(k.stats.conflicts, k.stats.decisions, event, payload))
+    return;
+  for (Ref ref = 0; ref < k.arena.size();) {
+    const Clause *c = clause_at(k.arena, ref);
+    if (!c->garbage() && c->size == pose_series_size) {
+      int lits[16], values[16];
+      for (unsigned i = 0; i < c->size; ++i) {
+        lits[i] = kernel_externalize(k, c->lits[i]);
+        values[i] = k.value(c->lits[i]);
+      }
+      if (pose_series_matches(lits))
+        pose_series_row(ref, c->redundant(), c->searched, lits, values);
+    }
+    ref += clause_actual_words(c);
+  }
+  pose_series_end();
+}
