   return alive;
 }
 
+static uint8_t fesym_ext_mark(const Kernel &k, Var v) {
+  if (v >= k.internal_to_external.size())
+    return 0;
+  const Var ev = k.internal_to_external[v];
+  return ev < k.symuse.fesym_ext_vars.size() ? k.symuse.fesym_ext_vars[ev] : 0;
+}
+
+bool kernel_fesym_var_tagged(const Kernel &k, Var v) {
+  return fesym_ext_mark(k, v) != 0;
+}
+
+static uint64_t fesym_alive_all(const Kernel &k) {
+  uint64_t alive = 0;
+  for (uint32_t run = 0; run < k.symuse.runs.size(); run++)
+    alive += kernel_symuse_alive(k, run);
+  return alive;
+}
+
+static uint64_t fesym_helpers_alive(const Kernel &k) {
+  uint64_t alive = 0;
+  for (const SymmetryUse::StableBinary &b : k.symuse.binaries) {
+    if (!(b.tag & SymmetryUse::HELPER))
+      continue;
+    const Lit a = symuse_internal(k, b.a), c = symuse_internal(k, b.b);
+    alive += a != INVALID_LIT && c != INVALID_LIT && kernel_binary_live(k, a, c);
+  }
+  return alive;
+}
+
+static long long fesym_dimacs(Var ev, bool neg) {
+  return (neg ? -1 : 1) * (static_cast<long long>(ev) + 1);
+}
+
+void kernel_fesym_fastel_begin(Kernel &k) {
+  SymmetryUse &u = k.symuse;
+  u.fesym_eliminated_before.assign(k.nvars, 0);
+  for (Var v = 0; v < k.nvars; v++)
+    u.fesym_eliminated_before[v] =
+        v < k.var_status.size() && k.var_status[v] == VarStatus::Eliminated;
+  u.fesym_alive_before = fesym_alive_all(k);
+  u.fesym_helpers_before = fesym_helpers_alive(k);
+}
+
+void kernel_fesym_fastel_end(Kernel &k, uint64_t frozen_skipped) {
+  SymmetryUse &u = k.symuse;
+  uint64_t eliminated = 0, tagged = 0, helper = 0;
+  std::vector<long long> listed, listed_tagged;
+  for (Var v = 0; v < k.nvars && v < u.fesym_eliminated_before.size(); v++) {
+    if (u.fesym_eliminated_before[v] || v >= k.var_status.size() ||
+        k.var_status[v] != VarStatus::Eliminated)
+      continue;
+    eliminated++;
+    const uint8_t mark = fesym_ext_mark(k, v);
+    tagged += (mark & 1) != 0;
+    helper += (mark & 2) != 0;
+    const long long ext = fesym_dimacs(k.internal_to_external[v], false);
+    if (listed.size() < 200) listed.push_back(ext);
+    if (mark && listed_tagged.size() < 200) listed_tagged.push_back(ext);
+  }
+  printf("c fesym fastel ran: tagged_vars=%llu eliminated=%llu "
+         "eliminated_in_tagged=%llu eliminated_in_helper=%llu "
+         "frozen_skipped=%llu tagged_alive_before=%llu tagged_alive_after=%llu "
+         "helpers_alive_before=%llu helpers_alive_after=%llu conflicts=%llu\n",
+         (unsigned long long)std::count_if(u.fesym_ext_vars.begin(),
+                                           u.fesym_ext_vars.end(),
+                                           [](uint8_t m) { return m != 0; }),
+         (unsigned long long)eliminated, (unsigned long long)tagged,
+         (unsigned long long)helper, (unsigned long long)frozen_skipped,
+         (unsigned long long)u.fesym_alive_before,
+         (unsigned long long)fesym_alive_all(k),
+         (unsigned long long)u.fesym_helpers_before,
+         (unsigned long long)fesym_helpers_alive(k),
+         (unsigned long long)k.stats.conflicts);
+  printf("c fesym fastel eliminated-vars");
+  for (const long long ext : listed) printf(" %lld", ext);
+  printf("\nc fesym fastel eliminated-tagged-vars");
+  for (const long long ext : listed_tagged) printf(" %lld", ext);
+  printf("\n");
+  fflush(stdout);
+  u.fesym_eliminated_before.clear();
+  u.fesym_last_alive = fesym_alive_all(k);
+}
+
+void kernel_fesym_fastel_skipped(Kernel &k) {
+  SymmetryUse &u = k.symuse;
+  u.fesym_last_alive = fesym_alive_all(k);
+  printf("c fesym fastel skipped: tagged_vars=%llu tagged_alive=%llu "
+         "helpers_alive=%llu\n",
+         (unsigned long long)std::count_if(u.fesym_ext_vars.begin(),
+                                           u.fesym_ext_vars.end(),
+                                           [](uint8_t m) { return m != 0; }),
+         (unsigned long long)u.fesym_last_alive,
+         (unsigned long long)fesym_helpers_alive(k));
+  fflush(stdout);
+}
+
+void kernel_fesym_after_eliminate(Kernel &k) {
+  SymmetryUse &u = k.symuse;
+  if (!k.symuse_active || u.fesym_elim_lines >= 64)
+    return;
+  const uint64_t alive = fesym_alive_all(k);
+  if (alive == u.fesym_last_alive)
+    return;
+  u.fesym_last_alive = alive;
+  u.fesym_elim_lines++;
+  printf("c fesym eliminate-phase conflicts=%llu tagged_alive=%llu "
+         "helpers_alive=%llu bve_eliminated=%llu\n",
+         (unsigned long long)k.stats.conflicts, (unsigned long long)alive,
+         (unsigned long long)fesym_helpers_alive(k),
+         (unsigned long long)k.stats.bve_eliminated);
+  fflush(stdout);
+}
+
+void kernel_fesym_note_decision(Kernel &k, Lit lit) {
+  SymmetryUse &u = k.symuse;
+  constexpr size_t PREFIX = 512;
+  if (u.fesym_decisions.size() >= PREFIX)
+    return;
+  const Lit ext = kernel_external_lit(k, lit);
+  u.fesym_decisions.push_back(fesym_dimacs(var_of(ext), negated(ext)));
+  if (u.fesym_decisions.size() == PREFIX) {
+    printf("c fesym decisions conflicts=%llu prefix",
+           (unsigned long long)k.stats.conflicts);
+    for (const long long d : u.fesym_decisions) printf(" %lld", d);
+    printf("\n");
+    fflush(stdout);
+  }
+}
+
 } // namespace tactix
