+#include "internal.h"
+#include "reference_order_trace.h"
+#include <stdio.h>
+#include <stdlib.h>
+#include <inttypes.h>
+void reference_order_event(kissat *solver,const char *event,unsigned idx,int elit,unsigned detail) {
+  static int initialized; static FILE *file; static unsigned count;
+  if(!initialized) {initialized=1;const char *path=getenv("REFERENCE_ORDER_TRACE");if(path&&*path){file=fopen(path,"w");if(!file)abort();setvbuf(file,0,_IOLBF,0);fprintf(file,"event\tconflicts\tlevel\tinternal\texternal\tdetail\tstable\twarming\n");}}
+  if(!file||CONFLICTS>50||count++>=30000)return;
+  if(fprintf(file,"%s\t%" PRIu64 "\t%u\t%u\t%d\t%u\t%d\t%d\n",event,(uint64_t)CONFLICTS,solver->level,idx,elit,detail,solver->stable,solver->warming)<0)abort();
+}
