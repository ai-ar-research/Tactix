+++ b/src/diagnostics/residual_order_probe.hpp
@@ -0,0 +1,33 @@
+#pragma once
+#include <cstdint>
+#include <unordered_map>
+namespace tactix {
+// Diagnostic-only presentation owner. Never a premise/proof-id archive.
+struct ResidualOrderDiagnostic {
+  struct Binary { uint64_t ordinal; uint32_t first,second; };
+  bool active=false,complete=false;
+  uint64_t next=0;
+  static constexpr size_t limit=262144;
+  std::unordered_map<uint64_t,Binary> binary;
+  std::unordered_map<uint64_t,uint64_t> large;
+  static uint64_t key(uint32_t a,uint32_t b) {
+    return a<b?(uint64_t(a)<<32)|b:(uint64_t(b)<<32)|a;
+  }
+  void release() {active=false;decltype(binary){}.swap(binary);decltype(large){}.swap(large);}
+  void unsupported(){complete=false;release();}
+  void arm(bool enable){release();next=0;active=complete=enable;}
+  bool reserve_record(){if(binary.size()+large.size()<limit)return true;unsupported();return false;}
+  void add_binary(uint32_t a,uint32_t b,bool new_pair) {
+    if(!active)return;
+    const uint64_t k=key(a,b);auto at=binary.find(k);
+    if(!new_pair){if(at==binary.end())unsupported();return;}
+    if(at==binary.end()&&!reserve_record())return;
+    binary[k]={++next,a,b};
+  }
+  void add_large(uint64_t id) {
+    if(!active)return;
+    if(!id||large.count(id)||!reserve_record()){unsupported();return;}
+    large.emplace(id,++next);
+  }
+};
+}
