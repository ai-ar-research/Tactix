+    assert(input);
+    std::fputs("p cnf 5 11\n-3 1 0\n-3 2 0\n3 -1 -2 0\n"
+               "-4 1 0\n-4 2 0\n4 -1 -2 0\n-5 3 0\n-5 4 0\n"
+               "5 -3 -4 0\n5 3 0\n-5 -3 0\n", input);
