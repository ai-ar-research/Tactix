# Apptainer recipe equivalent to paper/Dockerfile, for clusters without Docker.
#
#   apptainer build --fakeroot tactix.sif paper/tactix.def      (from the repository root)
#   apptainer shell tactix.sif                                    (the artifact is in /tactix)
#
# A SIF image is read-only: send output to a writable directory, e.g.
#   cd /tactix && paper/run/bench.py run smoke --out /tmp/results
#   make -C paper CHECK=/tmp/check check
#   make -C paper FIGURES=/tmp/figures figures report
Bootstrap: docker
From: ubuntu:24.04

%files
    . /tactix

%post
    /tactix/paper/install-deps.sh
    export PATH=/root/.elan/bin:$PATH TAR_OPTIONS=--no-same-owner
    cd /tactix
    paper/run/setup.sh all
    for e in tierd milestones interface cruxmiter chvatal; do
        paper/run/bench.py fetch $e --subset short
    done
    paper/run/bench.py fetch smoke

%environment
    export PATH=/root/.elan/bin:$PATH

%runscript
    cd /tactix && exec /bin/bash "$@"
