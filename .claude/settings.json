{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "permissions": {
    "deny": [
      "Read(session-*.txt)",
      "Read(//Users/haozewu/Projects/SAT-solving/session-*.txt)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read|Bash|Grep|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/deny-session-reads.sh\"",
            "statusMessage": "Guarding private session transcripts"
          }
        ]
      }
    ]
  }
}
