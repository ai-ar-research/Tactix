@@ -550,0 +562,43 @@ void printDependencies (struct solver *S, int* clause, int RATflag) {
+static inline long occSlot (struct solver *S, int lit) {
+  return 2L * (abs (lit) - S->nVars - 1) + (lit < 0); }
+
+// Scanning every clause for every RAT lemma costs (RAT lemmas) x (formula), and
+// a proof that factors has millions of such lemmas on extension variables. So on
+// first use, list the clauses holding each extension-variable literal, and track
+// which clauses are live. Input-variable pivots keep the scan, which keeps the
+// index down to the occurrences of proof-introduced variables.
+static void buildOccurrences (struct solver *S) {
+  const long slots = 2L * (S->maxVar - S->nVars);
+  long i; int j, pass;
+  S->occStart = (long *) calloc (slots + 1, sizeof (long));
+  S->live = (unsigned char *) calloc (S->count / 8 + 1, 1);
+  if (S->occStart == NULL || S->live == NULL) { printf ("c MEMOUT: RAT occurrence index\n"); exit (0); }
+  for (i = -S->maxVar; i <= S->maxVar; i++) {
+    if (i == 0) continue;
+    for (j = 0; j < S->used[i]; j++) {
+      int* watched = S->DB + (S->wlist[i][j] >> 1);
+      if (*watched == i) setLive (S, watched, 1); } }
+  // Only proof steps add clauses that can hold an extension variable.
+  for (pass = 0; pass < 2; pass++) {
+    for (i = 0; i < S->nStep; i++) {
+      const long ad = S->proof[i];
+      if (ad == 0 || (ad & DBIT)) continue;
+      const long offset = ad >> INFOBITS;
+      int *lit;
+      for (lit = S->DB + offset; *lit; lit++) {
+        if (abs (*lit) <= S->nVars) continue;
+        if (pass == 0) S->occStart[occSlot (S, *lit) + 1]++;
+        else S->occ[S->occStart[occSlot (S, *lit)]++] = offset; } }
+    if (pass == 0) {
+      for (i = 0; i < slots; i++) S->occStart[i + 1] += S->occStart[i];
+      S->occ = (long *) malloc (sizeof (long) * (S->occStart[slots] + 1));
+      if (S->occ == NULL) { printf ("c MEMOUT: RAT occurrence index\n"); exit (0); } } } }
+
+static inline int addRATcandidate (struct solver *S, int nRAT, long offset) {
+  if (nRAT == S->maxRAT) {
+    S->maxRAT = (S->maxRAT * 3) >> 1;
+    S->RATset = realloc (S->RATset, sizeof (long) * S->maxRAT);
+    assert (S->RATset != NULL); }
+  S->RATset[nRAT] = offset;
+  return nRAT + 1; }
+
@@ -553,0 +608,14 @@ int checkRAT (struct solver *S, int pivot, int mark) {
+  if (abs (pivot) > S->nVars) {
+    if (S->occStart == NULL) buildOccurrences (S);
+    // Filling moved each slot's start to its end, which is the next slot's start.
+    const long slot = occSlot (S, -pivot);
+    long at;
+    for (at = slot ? S->occStart[slot - 1] : 0; at < S->occStart[slot]; at++) {
+      const int* candidate = S->DB + S->occ[at];
+      const long number = candidate[ID] >> 1;
+      if (!(S->live[number >> 3] >> (number & 7) & 1)) continue;
+      if ((S->mode == BACKWARD_UNSAT) && !(candidate[ID] & ACTIVE)) continue;
+      // Optimization rounds can shorten a lemma after the index was built.
+      const int* lit = candidate;
+      while (*lit && *lit != -pivot) lit++;
+      if (*lit) nRAT = addRATcandidate (S, nRAT, S->occ[at]); } }
