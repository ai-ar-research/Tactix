diff -ruN -x makefile winners/kissat-sc2024/src/fttrace.h tools/solvers/variants/kissat-fastel-strengthen-trace/src/fttrace.h
--- winners/kissat-sc2024/src/fttrace.h	1969-12-31 19:00:00.000000000 -0500
+++ tools/solvers/variants/kissat-fastel-strengthen-trace/src/fttrace.h	2026-10-10 14:46:27.126010791 -0400
@@ -0,0 +1,36 @@
+#ifndef _fttrace_h_INCLUDED
+#define _fttrace_h_INCLUDED
+// Diagnostic-only fastel/decision trace (KISSAT_FT=1 enables; stderr).
+#include "inline.h"
+#include "internal.h"
+#include <stdio.h>
+#include <stdlib.h>
+
+static inline int ft_enabled (void) {
+  static int state = -1;
+  if (state < 0)
+    state = getenv ("KISSAT_FT") != 0;
+  return state;
+}
+
+static inline int ft_ext (kissat *solver, unsigned lit) {
+  return kissat_export_literal (solver, lit);
+}
+
+static inline void ft_lits (kissat *solver, const unsigned *lits,
+                            unsigned size) {
+  fputc ('[', stderr);
+  for (unsigned i = 0; i < size; i++)
+    fprintf (stderr, i ? " %d" : "%d", ft_ext (solver, lits[i]));
+  fputc (']', stderr);
+}
+
+static inline void ft_clause (kissat *solver, clause *c) {
+  ft_lits (solver, c->lits, c->size);
+}
+
+static inline void ft_stack (kissat *solver) {
+  ft_lits (solver, BEGIN_STACK (solver->clause),
+           SIZE_STACK (solver->clause));
+}
+#endif
