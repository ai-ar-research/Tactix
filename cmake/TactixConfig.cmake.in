# CMake package for an installed Tactix:
#   find_package(Tactix REQUIRED)
#   target_link_libraries(my_strategy PRIVATE Tactix::tactix)
@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
find_dependency(ZLIB)
find_dependency(Threads)

if(NOT TARGET Tactix::tactix)
  add_library(Tactix::archive STATIC IMPORTED)
  set_target_properties(Tactix::archive PROPERTIES
    IMPORTED_LOCATION "@PACKAGE_CMAKE_INSTALL_LIBDIR@/libtactix.a")
  # Rules register in static initializers: link every object of the archive.
  add_library(Tactix::tactix INTERFACE IMPORTED)
  set_target_properties(Tactix::tactix PROPERTIES
    INTERFACE_INCLUDE_DIRECTORIES "@PACKAGE_CMAKE_INSTALL_INCLUDEDIR@"
    INTERFACE_LINK_LIBRARIES
      "$<LINK_LIBRARY:WHOLE_ARCHIVE,Tactix::archive>;ZLIB::ZLIB;Threads::Threads;stdc++;m")
endif()
