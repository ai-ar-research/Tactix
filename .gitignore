*.pyc
cryptominisat/

# Editor artifacts
*.~undo-tree~

# Private per-session transcripts (USER-ONLY reference; agents are also blocked
# from reading these via .claude/settings.json — see .claude/hooks/deny-session-reads.sh)
session-*.txt

# Session-local adversarial-review worktree (an embedded repo, never a submodule)
adversarial-review/
