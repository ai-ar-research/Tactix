# Third-party solver sources kept locally for reference — never committed
kissat/
cadical/
minisat/
glucose/
drat-trim/
cake_lpr/
dsr-trim-sr/
trestle/
winners/
/benchmarks/
report-to-andrew/

# Locally built third-party binaries (symlinks from tools/*/setup.sh)
tools/solvers/bin/
tools/checkers/bin/

# PATCHED/INSTRUMENTED reference builds (L14: a variant must not be built inside
# the PINNED CLONE, because tools/solvers/bin/* symlink into it and a rebuild
# would silently replace the baseline every tier run measures against). They live
# here rather than in $HOME — same safety property, no spillover (re-org 2026-08-03).
tools/solvers/variants/
# The rule-journal adapter is source-owned even though generated variant trees
# and binaries below this directory remain local diagnostics.
!tools/solvers/variants/
tools/solvers/variants/*
!tools/solvers/variants/kissat-event-trace/
tools/solvers/variants/kissat-event-trace/*
!tools/solvers/variants/kissat-event-trace/prepare.py
!tools/solvers/variants/kissat-event-trace/overlay/
tools/solvers/variants/kissat-event-trace/overlay/*
!tools/solvers/variants/kissat-event-trace/overlay/rulejournal.c
!tools/solvers/variants/kissat-event-trace/overlay/rulejournal.h
!tools/solvers/variants/lymphosat-modlog/
tools/solvers/variants/lymphosat-modlog/*
!tools/solvers/variants/lymphosat-modlog/README.md
!tools/solvers/variants/lymphosat-modlog/prepare.py
!tools/solvers/variants/lymphosat-modlog/overlay/
tools/solvers/variants/lymphosat-modlog/overlay/*
!tools/solvers/variants/lymphosat-modlog/overlay/main.cpp

# Probe scratch (regenerable artifacts: preserved proofs, decompressed CNFs)
benchmarks/probes/scratch/

# Build artifacts
build/
*.o
*.a
*.so
*.dylib

# Benchmark instances are cached locally, only tier lists are tracked
benchmarks/cache/
*.cnf.xz
*.tar.xz

# Fuzz failure bundles (promoted manually to tools/fuzz/corpus/regressions/)
tools/fuzz/failures/

# Per-job fuzz logs. CLAUDE.md puts throwaway job logs in $CLAUDE_JOB_DIR/tmp:
# a leg's VERDICT belongs in PROGRESS.md and its report, and the log itself is
# regenerable from the job. The 73 already tracked need a retention decision
# (review item RV-S9) before they are removed, since frozen reports cite some.
tools/fuzz/slurm-*.log
tools/fuzz/nightly-rev*.log

# Solver run outputs
*.drat
*.lrat
*.proof
*.model
# ...except each window's two SUMMARY files. Note the shape: excluding the
# DIRECTORY makes git skip descending into it, so a negation under it never
# matches. The contents must be excluded and the directories re-admitted.
benchmarks/runs/*
!benchmarks/runs/*/
benchmarks/runs/*/*
!benchmarks/runs/*/results.json
!benchmarks/runs/*/manifest.json
# Rationale for tracking them at all: `benchmarks/runs/` is 7.1 GB and
# untracked, but plan §8.1 makes it AUTHORITATIVE for per-instance
# detail — so without this the only copy of every gate's evidence is one
# `rm -rf` or one quota event from gone, and no report reconstructs it. The two
# JSONs are 2.7 MB across 217 windows; the bulk is logs/ and results/, which
# stay ignored.

# Editor / OS
.DS_Store
.vscode/
.idea/
compile_commands.json
__pycache__/
*.pyc
cryptominisat/

# Wrap-up deliverables are local handoff artifacts. The four historical report
# pairs already tracked by Git remain tracked despite this rule.
report-to-andrew/*/

# Editor artifacts
*.~undo-tree~

# Private per-session transcripts (USER-ONLY reference; agents are also blocked
# from reading these via .claude/settings.json — see .claude/hooks/deny-session-reads.sh)
session-*.txt

# Session-local adversarial-review worktree (an embedded repo, never a submodule)
adversarial-review/

# The paper artifact ships its own archives and compressed instances
!/paper/logs/**/*.tar.xz
!/paper/benchmarks/**

# Development material kept locally, outside the public repository
/CLAUDE.md
/.claude/
/PROGRESS.md
/DEVELOPMENT_PLAN.md
/review.md
/report-to-andrew/
/docs/design/
/docs/log/
/docs/lessons.md
/docs/papers/
/docs/winner-integration-plan.md
/docs/semantic-extension-foundations.md
/tools/solvers/variants/
/docs/development-map.md
/tools/fuzz/slurm-*.log
/corpus/

# Built by paper/run/setup.sh from tools/bench/dsr_transport.cpp
tools/bench/dsr-transport
tools/bench/dsr-transport.sha256
